@implements IAsyncDisposable
@inject IJSRuntime JS
@using Kuulla.Web.Services.Sync

@if (Service.IsSyncing)
{
    <span class="text-muted small" aria-live="polite">
        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
        Syncing&hellip;
    </span>
}
else if (Service.HasRemoteUpdate)
{
    <button type="button" class="btn btn-sm btn-outline-info" @onclick="AcknowledgeAsync" aria-live="polite">
        Updated from another device
    </button>
}

@code {
    // Bound to the non-generic ISyncStatusService surface so this component works for any
    // domain's SyncStatusService<TState> (#86) without itself being generic.
    [Parameter, EditorRequired]
    public ISyncStatusService Service { get; set; } = null!;

    private IJSObjectReference? _module;
    private IJSObjectReference? _watcher;
    private DotNetObjectReference<SyncStatusIndicator>? _selfReference;

    protected override void OnInitialized()
    {
        Service.StateChanged += HandleServiceStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", Assets["Components/Sync/SyncStatusIndicator.razor.js"]);
        _selfReference = DotNetObjectReference.Create(this);
        _watcher = await _module.InvokeAsync<IJSObjectReference>("register", _selfReference);
    }

    [JSInvokable]
    public async Task OnFocusRegained()
    {
        try
        {
            await Service.CheckNowAsync();
        }
        catch (Exception)
        {
            // A poll failure (e.g. the API is briefly unreachable when the tab regains focus)
            // shouldn't fault the circuit — CheckNowAsync already resets IsSyncing in its
            // finally block, so there's nothing further to reconcile here; the next focus event
            // or explicit check will simply try again.
        }
    }

    private async Task AcknowledgeAsync()
    {
        await Service.AcknowledgeRemoteUpdateAsync();
    }

    private void HandleServiceStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Service.StateChanged -= HandleServiceStateChanged;

        // Every step below is a JS interop call and can throw JSDisconnectedException if the
        // circuit is already gone (e.g. the tab was closed) — there's nothing left to clean up
        // client-side in that case. Each step is guarded independently so one already-gone
        // circuit doesn't skip disposing the others.
        if (_watcher is not null)
        {
            try
            {
                await _watcher.InvokeVoidAsync("dispose");
            }
            catch (JSDisconnectedException)
            {
            }

            try
            {
                await _watcher.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfReference?.Dispose();
    }
}
