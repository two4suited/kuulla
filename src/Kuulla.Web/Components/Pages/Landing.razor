@page "/welcome"
@layout EmptyLayout
@using Kuulla.Web.Models
@using Kuulla.Web.Services
@inject ChangelogProvider Changelog

@*
    Public marketing page. Rendered two ways, both anonymous:
      - directly at /welcome (stable marketing URL), and
      - by Home.razor's <NotAuthorized> branch, so a logged-out visit to "/" lands here.
    Static SSR — no @rendermode. Served by the existing Kuulla.Web app; no new infra.
    Deliberately locked to the Signal dark palette (docs/brand.md §1); the theme toggle
    doesn't apply here.
*@

<PageTitle>Kuulla — Podcasts, edited like radio.</PageTitle>

<HeadContent>
    <meta name="description" content="A podcast player built for audio quality and instant cross-device sync. Pause on your phone, resume on your laptop — in under a second." />
    <meta property="og:title" content="Kuulla — Pause here. Resume there." />
    <meta property="og:description" content="A podcast player built for audio quality and instant cross-device sync." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="img/og-card.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="img/og-card.png" />
</HeadContent>

<div class="landing" data-bs-theme="dark">
    <header class="l-header">
        <a class="l-brand" href="welcome">
            <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" width="26" height="26">
                <polyline points="8,21 16,10 24,23" fill="none" stroke="#5a5f68" stroke-width="3"
                          stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="8" cy="21" r="4" fill="#f4f4f2" />
                <circle cx="24" cy="23" r="4" fill="#f4f4f2" />
                <circle cx="16" cy="10" r="4.6" fill="#c6f24e" />
            </svg>
            Kuulla
        </a>
        <div class="l-header-actions">
            <LoginDisplay />
        </div>
    </header>

    <main>
        <section class="l-hero">
            <div class="l-hero-copy">
                <p class="l-eyebrow">Podcasts, edited like radio.</p>
                <h1>Pause here.<br />Resume there.</h1>
                <p class="l-sub">
                    Position, queue, and downloads reconcile in under a second — phone,
                    laptop, car. No “which device was I on?”
                </p>
                <div class="l-cta">
                    <a class="l-btn l-btn-primary" href="Account/Login?returnUrl=%2F">Open web player</a>
                    <a class="l-btn l-btn-ghost" href="https://apps.apple.com/app/kuulla" aria-label="Get the iOS app (coming soon)">Get the app</a>
                </div>
                <p class="l-cta-note">iOS app in TestFlight · web player works today</p>
            </div>

            <div class="l-hero-art" aria-hidden="true">
                <svg viewBox="0 0 400 400" class="l-graph">
                    <polyline points="70,250 150,120 230,300 330,180" fill="none" stroke="#333" stroke-width="14"
                              stroke-linecap="round" stroke-linejoin="round" />
                    <line x1="150" y1="120" x2="330" y2="180" class="l-graph-sync" stroke="#c6f24e" stroke-width="3" stroke-linecap="round" />
                    <circle cx="70" cy="250" r="17" fill="#f4f4f2" />
                    <circle cx="230" cy="300" r="17" fill="#f4f4f2" />
                    <circle cx="150" cy="120" r="21" fill="#c6f24e" class="l-node l-node-a" />
                    <circle cx="330" cy="180" r="21" fill="#c6f24e" class="l-node l-node-b" />
                </svg>
            </div>
        </section>

        <section class="l-props">
            <div class="l-prop">
                <h2>Audio quality first</h2>
                <p>High-bitrate streams, loudness-normalized so every show sits at the same level. No bandwidth-saving compromises.</p>
            </div>
            <div class="l-prop">
                <h2>Sync that keeps up</h2>
                <p>Sub-second, conflict-free. Start an episode in the kitchen, finish it in the car — it just picks up.</p>
            </div>
            <div class="l-prop">
                <h2>Native everywhere</h2>
                <p>A real iOS app with background audio and CarPlay, and a full web player that shares the same account.</p>
            </div>
        </section>

        <section class="l-features">
            <p class="l-eyebrow">What's inside</p>
            <h2 class="l-features-h">A full player, not a demo</h2>
            <div class="l-feature-grid">
                <div class="l-feature">
                    <span class="l-feature-tag">synced 2s ago</span>
                    <h3>Continuous sync</h3>
                    <p>Position, queue, subscriptions, and downloads reconcile in under a second — conflict-free. Pick up on any device mid-sentence.</p>
                </div>
                <div class="l-feature">
                    <span class="l-feature-tag">-14 LUFS</span>
                    <h3>Loudness-normalized</h3>
                    <p>Every show plays at the same level — no diving for the volume between episodes. High-bitrate streams, gapless playback.</p>
                </div>
                <div class="l-feature">
                    <span class="l-feature-tag">smartspeed</span>
                    <h3>SmartSpeed</h3>
                    <p>Trims dead air and lifts quiet passages in real time, with speed control that stays pitch-correct — no chipmunk.</p>
                </div>
                <div class="l-feature">
                    <span class="l-feature-tag">skip 00:15</span>
                    <h3>Auto-skip intro &amp; outro</h3>
                    <p>Set a skip once per show and never sit through the same cold open — or the same credits — again.</p>
                </div>
                <div class="l-feature">
                    <span class="l-feature-tag">transcript</span>
                    <h3>Transcripts that follow along</h3>
                    <p>The line you're hearing stays lit. Tap any line to jump there; search the transcript for the moment you half-remember.</p>
                </div>
                <div class="l-feature">
                    <span class="l-feature-tag">ch. 03</span>
                    <h3>Chapters on the scrubber</h3>
                    <p>A tick for every chapter, tap to jump, and tap the one you're in to open its link.</p>
                </div>
                <div class="l-feature">
                    <span class="l-feature-tag">carplay</span>
                    <h3>Native CarPlay</h3>
                    <p>Now Playing, your queue, and chapters on the dash — with background audio for the whole drive.</p>
                </div>
                <div class="l-feature">
                    <span class="l-feature-tag">00:30:00</span>
                    <h3>Sleep timer</h3>
                    <p>Fades out on a countdown or at the end of the episode. Your default duration seeds every other device.</p>
                </div>
                <div class="l-feature">
                    <span class="l-feature-tag">priority</span>
                    <h3>Dynamic playlists</h3>
                    <p>Build a feed from your shows in priority order — unplayed episodes only, capped wherever you want it.</p>
                </div>
                <div class="l-feature">
                    <span class="l-feature-tag">offline</span>
                    <h3>Downloads on your terms</h3>
                    <p>Auto-download new episodes, auto-delete once played, and keep it to Wi-Fi. Then listen anywhere.</p>
                </div>
                <div class="l-feature">
                    <span class="l-feature-tag">new</span>
                    <h3>New-episode alerts</h3>
                    <p>A push the moment a show you follow drops an episode — tap straight into it.</p>
                </div>
                <div class="l-feature">
                    <span class="l-feature-tag">kuulla.app</span>
                    <h3>A real web player</h3>
                    <p>Same account, same queue, any browser — so you're never stuck without your shows.</p>
                </div>
            </div>
            <p class="l-also">
                Also: Up Next queue · trending &amp; category discovery · OPML import /
                export · Home Screen widgets · Siri Shortcuts · auto-archive played
                episodes · Wi-Fi-only streaming · per-show playback overrides
            </p>
        </section>

        <section class="l-shot">
            <div class="l-phone">
                <img src="img/ss-ios-episode.png" alt="Kuulla on iOS — an episode with playback controls, a monospace timestamp, and an “In Progress” marker" loading="lazy" />
            </div>
            <div class="l-shot-copy">
                <p class="l-eyebrow">On the phone</p>
                <h2>Every timestamp, in the open</h2>
                <p>Elapsed time, chapter marks, and “synced 2s ago” are shown, not hidden. You always know where you are and which device wrote it last.</p>
            </div>
        </section>

        <section class="l-shot l-shot--reverse">
            <div class="l-phone">
                <img src="img/ss-ios-show.png" alt="Kuulla on iOS — a show page with episode filters for All, Unplayed, In Progress, and Downloaded, and per-episode progress bars" loading="lazy" />
            </div>
            <div class="l-shot-copy">
                <p class="l-eyebrow">Your library</p>
                <h2>Filtered the way you actually listen</h2>
                <p>Every show splits into Unplayed, In Progress, and Downloaded. Progress bars, “New” and “In Progress” markers, and newest-first sort — no hunting for where you stopped.</p>
            </div>
        </section>
        @if (releases.Count > 0)
        {
            <section class="l-whatsnew">
                <p class="l-eyebrow">What's new</p>
                <h2 class="l-features-h">Shipped recently</h2>
                <ol class="l-releases">
                    @foreach (var release in releases)
                    {
                        <li class="l-release">
                            <div class="l-release-meta">
                                <a class="l-release-v" href="@release.Url">@release.Version</a>
                                @if (release.PublishedOn is { } published)
                                {
                                    <time datetime="@published.ToString("yyyy-MM-dd")">@published.ToString("MMM d, yyyy")</time>
                                }
                            </div>
                            <div class="l-release-changes">
                                @foreach (var group in release.Groups)
                                {
                                    <div class="l-release-group">
                                        <span class="l-release-group-title">@group.Title</span>
                                        <ul>
                                            @foreach (var item in group.Items)
                                            {
                                                <li>@item</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </li>
                    }
                </ol>
                <p class="l-also">
                    Every release, with full notes, on
                    <a href="https://github.com/two4suited/kuulla/releases">GitHub</a>.
                </p>
            </section>
        }
    </main>

    <footer class="l-footer">
        <span>Kuulla <span class="l-version">@BuildInfo.Version</span></span>
        <nav>
            <a href="Account/Login?returnUrl=%2F">Web player</a>
            <a href="https://github.com/sheridan-apps/kuulla">GitHub</a>
            <a href="mailto:hello@kuulla.app">Contact</a>
        </nav>
    </footer>
</div>

@code {
    // From the committed CHANGELOG.md, read once at startup. Empty (section skipped) when the
    // file is missing — e.g. a local build that never ran the release workflow.
    private IReadOnlyList<ReleaseNote> releases = [];

    protected override void OnInitialized()
    {
        releases = Changelog.GetRecent(count: 3);
    }
}
