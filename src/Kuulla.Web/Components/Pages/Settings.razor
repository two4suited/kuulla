@page "/settings"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Kuulla.Web.Models
@using Kuulla.Web.Services
@using Kuulla.Web.Services.Sync
@inject SettingsClient SettingsClient
@inject SubscriptionClient SubscriptionClient
@inject IJSRuntime JS

<PageTitle>Settings</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h1 class="mb-0">Settings</h1>
            @if (syncStatusService is not null)
            {
                <SyncStatusIndicator Service="syncStatusService" />
            }
        </div>

        @if (isLoading)
        {
            <p>Loading&hellip;</p>
        }
        else if (loadError is not null)
        {
            <p class="text-danger">@loadError</p>
        }
        else
        {
            <div class="mb-3" style="max-width: 24rem;">
                <label class="form-label" for="unlistened-episode-count">Unlistened episodes to show per podcast</label>
                <select id="unlistened-episode-count" class="form-select" disabled="@isSaving"
                        value="@selectedUnlistenedEpisodeCount" @onchange="OnUnlistenedEpisodeCountChangedAsync">
                    @foreach (var option in UnlistenedEpisodeCountUi.Options)
                    {
                        <option value="@option">@UnlistenedEpisodeCountUi.Format(option)</option>
                    }
                </select>
            </div>

            <div class="mb-3" style="max-width: 24rem;">
                <label class="form-label" for="auto-archive-rule">Auto-archive played episodes</label>
                <select id="auto-archive-rule" class="form-select" disabled="@isArchiveSaving"
                        value="@selectedAutoArchiveRule" @onchange="OnAutoArchiveRuleChangedAsync">
                    @foreach (var option in AutoArchiveRuleUi.Options)
                    {
                        <option value="@option">@AutoArchiveRuleUi.Format(option)</option>
                    }
                </select>
                @if (archiveSaveError is not null)
                {
                    <p class="text-danger mt-1 mb-0">@archiveSaveError</p>
                }
                else if (archiveSaveSavedConfirmation)
                {
                    <p class="text-success mt-1 mb-0">Saved.</p>
                }
            </div>

            <div class="mb-3" style="max-width: 24rem;">
                <label class="form-label" for="auto-skip-intro-seconds">Auto-skip intro</label>
                <select id="auto-skip-intro-seconds" class="form-select" disabled="@isAutoSkipSaving"
                        value="@selectedAutoSkipIntroSeconds" @onchange="OnAutoSkipIntroSecondsChangedAsync">
                    @foreach (var option in AutoSkipDurationUi.OptionsIncluding(selectedAutoSkipIntroSeconds))
                    {
                        <option value="@option">@AutoSkipDurationUi.Format(option)</option>
                    }
                </select>
            </div>

            <div class="mb-3" style="max-width: 24rem;">
                <label class="form-label" for="auto-skip-outro-seconds">Auto-skip outro</label>
                <select id="auto-skip-outro-seconds" class="form-select" disabled="@isAutoSkipSaving"
                        value="@selectedAutoSkipOutroSeconds" @onchange="OnAutoSkipOutroSecondsChangedAsync">
                    @foreach (var option in AutoSkipDurationUi.OptionsIncluding(selectedAutoSkipOutroSeconds))
                    {
                        <option value="@option">@AutoSkipDurationUi.Format(option)</option>
                    }
                </select>
                @if (autoSkipSaveError is not null)
                {
                    <p class="text-danger mt-1 mb-0">@autoSkipSaveError</p>
                }
                else if (autoSkipSaveSavedConfirmation)
                {
                    <p class="text-success mt-1 mb-0">Saved.</p>
                }
            </div>

            <div class="mb-3" style="max-width: 24rem;">
                <label class="form-label" for="playback-speed">Playback speed</label>
                <select id="playback-speed" class="form-select" disabled="@isPlaybackSpeedSaving"
                        value="@selectedPlaybackSpeed.ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="OnPlaybackSpeedChangedAsync">
                    @foreach (var option in PlaybackSpeedUi.OptionsIncluding(selectedPlaybackSpeed))
                    {
                        <option value="@option.ToString(System.Globalization.CultureInfo.InvariantCulture)">@PlaybackSpeedUi.Format(option)</option>
                    }
                </select>
                @if (playbackSpeedSaveError is not null)
                {
                    <p class="text-danger mt-1 mb-0">@playbackSpeedSaveError</p>
                }
                else if (playbackSpeedSaveSavedConfirmation)
                {
                    <p class="text-success mt-1 mb-0">Saved.</p>
                }
            </div>

            <div class="mb-3" style="max-width: 24rem;">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="smart-speed"
                           disabled="@isSmartSpeedSaving" checked="@selectedSmartSpeed"
                           @onchange="OnSmartSpeedChangedAsync" />
                    <label class="form-check-label" for="smart-speed">SmartSpeed</label>
                </div>
                <div class="form-text">Trims silence and boosts quiet passages during playback.</div>
                @if (smartSpeedSaveError is not null)
                {
                    <p class="text-danger mt-1 mb-0">@smartSpeedSaveError</p>
                }
                else if (smartSpeedSaveSavedConfirmation)
                {
                    <p class="text-success mt-1 mb-0">Saved.</p>
                }
            </div>

            <div class="mb-3" style="max-width: 24rem;">
                <label class="form-label" for="play-next">When an episode finishes</label>
                <select id="play-next" class="form-select" disabled="@isPlayNextSaving"
                        value="@selectedPlayNextBehavior" @onchange="OnPlayNextBehaviorChangedAsync">
                    @foreach (var option in PlayNextBehaviorUi.Options)
                    {
                        <option value="@option">@PlayNextBehaviorUi.Format(option)</option>
                    }
                </select>
                <div class="form-text">Applies to whatever list you started playing from — a show, a playlist, Up Next or New Episodes. Override it per podcast from a show's page, or per playlist when editing one.</div>
                @if (playNextSaveError is not null)
                {
                    <p class="text-danger mt-1 mb-0">@playNextSaveError</p>
                }
                else if (playNextSaveSavedConfirmation)
                {
                    <p class="text-success mt-1 mb-0">Saved.</p>
                }
            </div>

            <div class="mb-3" style="max-width: 24rem;">
                <label class="form-label" for="sleep-timer-default-duration">Default sleep timer duration</label>
                <select id="sleep-timer-default-duration" class="form-select" disabled="@isSleepTimerDefaultDurationSaving"
                        value="@(selectedSleepTimerDefaultDurationMinutes?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                        @onchange="OnSleepTimerDefaultDurationChangedAsync">
                    @if (selectedSleepTimerDefaultDurationMinutes is null)
                    {
                        <option value="">Not set</option>
                    }
                    @foreach (var option in SleepTimerDurationUi.OptionsIncluding(selectedSleepTimerDefaultDurationMinutes))
                    {
                        <option value="@option.ToString(System.Globalization.CultureInfo.InvariantCulture)">@SleepTimerDurationUi.Format(option)</option>
                    }
                </select>
                <div class="form-text">Used to seed the sleep timer on your other devices — not itself a running timer.</div>
                @if (sleepTimerDefaultDurationSaveError is not null)
                {
                    <p class="text-danger mt-1 mb-0">@sleepTimerDefaultDurationSaveError</p>
                }
                else if (sleepTimerDefaultDurationSaveSavedConfirmation)
                {
                    <p class="text-success mt-1 mb-0">Saved.</p>
                }
            </div>

            <h2 class="h5 mt-4">Downloads &amp; Storage</h2>

            <div class="mb-3" style="max-width: 24rem;">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="auto-download-new-episodes"
                           disabled="@isAutoDownloadSaving" checked="@selectedAutoDownloadNewEpisodes"
                           @onchange="OnAutoDownloadNewEpisodesChangedAsync" />
                    <label class="form-check-label" for="auto-download-new-episodes">Auto-download new episodes</label>
                </div>
                @if (autoDownloadSaveError is not null)
                {
                    <p class="text-danger mt-1 mb-0">@autoDownloadSaveError</p>
                }
                else if (autoDownloadSaveSavedConfirmation)
                {
                    <p class="text-success mt-1 mb-0">Saved.</p>
                }
            </div>

            <div class="mb-3" style="max-width: 24rem;">
                <label class="form-label" for="auto-delete-rule">Delete downloads</label>
                <select id="auto-delete-rule" class="form-select" disabled="@isAutoDeleteSaving"
                        value="@selectedAutoDeleteRule" @onchange="OnAutoDeleteRuleChangedAsync">
                    @foreach (var option in AutoDeleteRuleUi.Options)
                    {
                        <option value="@option">@AutoDeleteRuleUi.Format(option)</option>
                    }
                </select>
                @if (selectedAutoDeleteRule == AutoDeleteRule.AfterDays)
                {
                    <div class="mt-2 d-flex align-items-center gap-2">
                        <label class="form-label mb-0" for="auto-delete-after-days">After</label>
                        <input id="auto-delete-after-days" type="number" class="form-control" style="width: 6rem;"
                               min="1" max="365" disabled="@isAutoDeleteSaving" value="@selectedAutoDeleteAfterDays"
                               @onchange="OnAutoDeleteAfterDaysChangedAsync" />
                        <span>day(s)</span>
                    </div>
                }
                @if (autoDeleteSaveError is not null)
                {
                    <p class="text-danger mt-1 mb-0">@autoDeleteSaveError</p>
                }
                else if (autoDeleteSaveSavedConfirmation)
                {
                    <p class="text-success mt-1 mb-0">Saved.</p>
                }
            </div>

            <h2 class="h5 mt-4">Data Usage &amp; Network</h2>

            <div class="mb-3" style="max-width: 24rem;">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="wifi-only-streaming"
                           disabled="@(!hasLoadedWifiOnlyStreaming)" checked="@wifiOnlyStreaming"
                           @onchange="OnWifiOnlyStreamingChangedAsync" />
                    <label class="form-check-label" for="wifi-only-streaming">Stream over Wi-Fi only</label>
                </div>
            </div>

            <h2 class="h5 mt-4">Import &amp; Export</h2>

            <div class="d-flex flex-column gap-1 mb-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <label class="btn btn-outline-secondary btn-sm mb-0 @(isImporting ? "disabled" : null)">
                        <InputFile OnChange="OnOpmlFileSelectedAsync" accept=".opml,.xml" disabled="@isImporting" class="d-none" />
                        @(isImporting ? "Importing…" : "Import OPML")
                    </label>
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            @onclick="OnExportOpmlAsync" disabled="@isExporting">
                        @(isExporting ? "Exporting…" : "Export OPML")
                    </button>
                </div>
                <div class="form-text">Bring your library over from another podcast app. Shows you already follow are skipped.</div>

                @if (importError is not null)
                {
                    <p class="text-danger small mb-0">@importError</p>
                }

                @if (exportError is not null)
                {
                    <p class="text-danger small mb-0">@exportError</p>
                }

                @if (importResult is not null)
                {
                    <p class="small mb-0">
                        Added @importResult.Added, skipped @importResult.AlreadySubscribed already subscribed@(importResult.Failed.Count > 0 ? $", {importResult.Failed.Count} failed" : string.Empty).
                        @if (importResult.Failed.Count > 0)
                        {
                            <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline" @onclick="() => showImportFailures = !showImportFailures">
                                @(showImportFailures ? "Hide" : "Show") failures
                            </button>
                        }
                    </p>
                    @if (showImportFailures && importResult.Failed.Count > 0)
                    {
                        <ul class="small text-muted mb-0">
                            @foreach (var failure in importResult.Failed)
                            {
                                <li><code>@failure.FeedUrl</code> — @failure.Reason</li>
                            }
                        </ul>
                    }
                }
            </div>

            @if (saveError is not null)
            {
                <p class="text-danger">@saveError</p>
            }
            else if (showSavedConfirmation)
            {
                <p class="text-success">Saved.</p>
            }
        }
    </Authorized>
    <NotAuthorized>
        <h1>Settings</h1>
        <p>You need to <a href="Account/Login">log in</a> to view this page.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool isLoading;
    private string? loadError;
    private UnlistenedEpisodeCount selectedUnlistenedEpisodeCount;
    private bool isSaving;
    private string? saveError;
    private bool showSavedConfirmation;
    private AutoArchiveRule selectedAutoArchiveRule;
    private bool isArchiveSaving;
    private string? archiveSaveError;
    private bool archiveSaveSavedConfirmation;
    private int selectedAutoSkipIntroSeconds;
    private int selectedAutoSkipOutroSeconds;
    private bool isAutoSkipSaving;
    private string? autoSkipSaveError;
    private bool autoSkipSaveSavedConfirmation;
    private int autoSkipSaveVersion;
    private readonly SemaphoreSlim autoSkipSaveLock = new(1, 1);
    private float selectedPlaybackSpeed;
    private bool isPlaybackSpeedSaving;
    private string? playbackSpeedSaveError;
    private bool playbackSpeedSaveSavedConfirmation;
    private bool selectedSmartSpeed;
    private bool isSmartSpeedSaving;
    private string? smartSpeedSaveError;
    private bool smartSpeedSaveSavedConfirmation;
    private PlayNextBehavior selectedPlayNextBehavior;
    private bool isPlayNextSaving;
    private string? playNextSaveError;
    private bool playNextSaveSavedConfirmation;
    private int? selectedSleepTimerDefaultDurationMinutes;
    private bool isSleepTimerDefaultDurationSaving;
    private string? sleepTimerDefaultDurationSaveError;
    private bool sleepTimerDefaultDurationSaveSavedConfirmation;
    private bool selectedAutoDownloadNewEpisodes;
    private bool isAutoDownloadSaving;
    private string? autoDownloadSaveError;
    private bool autoDownloadSaveSavedConfirmation;
    private AutoDeleteRule selectedAutoDeleteRule;
    private int selectedAutoDeleteAfterDays;
    private bool isAutoDeleteSaving;
    private string? autoDeleteSaveError;
    private bool autoDeleteSaveSavedConfirmation;
    private int autoDeleteSaveVersion;
    private readonly SemaphoreSlim autoDeleteSaveLock = new(1, 1);
    // Device-local (localStorage, per docs/data-usage-network-settings.md) — no UserSettings field
    // and no API round-trip, so this isn't loaded in OnInitializedAsync alongside the rest of this
    // page's settings; it's read via JS interop in OnAfterRenderAsync instead (JS interop isn't
    // available before the first render even with prerender: false during static-first HTTP
    // requests). Starts disabled until that first read completes, so a stale default-false render
    // can't be toggled before the real stored value is known.
    private bool wifiOnlyStreaming;
    private bool hasLoadedWifiOnlyStreaming;
    private SyncStatusService<UserSettings>? syncStatusService;

    // OPML import/export. MaxOpmlBytes matches OpmlParser.MaxDocumentBytes on the API — guarded
    // client-side too so an oversized file fails fast without a wasted upload.
    private const long MaxOpmlBytes = 5 * 1024 * 1024;
    private bool isImporting;
    private string? importError;
    private OpmlImportResult? importResult;
    private bool showImportFailures;
    private bool isExporting;
    private string? exportError;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // localStorage access can throw (e.g. private browsing with storage blocked) — falls back
        // to the documented default (false) rather than leaving the toggle stuck disabled forever.
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "wifiOnlyStreaming");
            wifiOnlyStreaming = stored == "true";
        }
        catch (JSException)
        {
            wifiOnlyStreaming = false;
        }
        finally
        {
            hasLoadedWifiOnlyStreaming = true;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // AuthorizeView alone only gates rendering; without this check the data load below would
        // still run (and fail with a caught-but-wasted 401) for anonymous visitors.
        var authState = await AuthenticationStateTask!;
        if (authState.User.Identity?.IsAuthenticated is not true)
        {
            return;
        }

        isLoading = true;
        try
        {
            var settings = await SettingsClient.GetSettingsAsync();
            selectedUnlistenedEpisodeCount = settings.UnlistenedEpisodeCount;
            selectedAutoArchiveRule = settings.AutoArchiveRule;
            selectedAutoSkipIntroSeconds = settings.AutoSkipIntroSeconds;
            selectedAutoSkipOutroSeconds = settings.AutoSkipOutroSeconds;
            selectedPlaybackSpeed = settings.PlaybackSpeed;
            selectedSmartSpeed = settings.SmartSpeed;
            selectedPlayNextBehavior = settings.PlayNextBehavior;
            selectedSleepTimerDefaultDurationMinutes = settings.SleepTimerDefaultDurationMinutes;
            selectedAutoDownloadNewEpisodes = settings.AutoDownloadNewEpisodes;
            selectedAutoDeleteRule = settings.AutoDeleteRule;
            selectedAutoDeleteAfterDays = settings.AutoDeleteAfterDays;
        }
        catch (HttpRequestException)
        {
            loadError = "Something went wrong while loading your settings. Please try again.";
        }
        finally
        {
            isLoading = false;
        }

        if (loadError is not null)
        {
            return;
        }

        // Kept out of the try/catch above on purpose: the sync-status indicator is supplementary,
        // so a hiccup seeding it shouldn't hide already-loaded settings.
        try
        {
            var initialSync = await SettingsClient.SyncAsync(string.Empty, DateTimeOffset.MinValue);
            syncStatusService = new SyncStatusService<UserSettings>(
                SettingsClient.SyncAsync,
                ApplyServerChanges,
                initialSync.Hash,
                initialSync.SyncedAt);
        }
        catch (HttpRequestException)
        {
        }
    }

    // At most one server change ever comes back (a user has exactly one UserSettings record) —
    // apply it to every field this page renders, same as a fresh GetSettingsAsync load.
    private void ApplyServerChanges(IReadOnlyList<UserSettings> serverChanges)
    {
        if (serverChanges.Count == 0)
        {
            return;
        }

        var settings = serverChanges[^1];
        selectedUnlistenedEpisodeCount = settings.UnlistenedEpisodeCount;
        selectedAutoArchiveRule = settings.AutoArchiveRule;
        selectedAutoSkipIntroSeconds = settings.AutoSkipIntroSeconds;
        selectedAutoSkipOutroSeconds = settings.AutoSkipOutroSeconds;
        selectedPlaybackSpeed = settings.PlaybackSpeed;
        selectedSmartSpeed = settings.SmartSpeed;
        selectedPlayNextBehavior = settings.PlayNextBehavior;
        selectedSleepTimerDefaultDurationMinutes = settings.SleepTimerDefaultDurationMinutes;
        selectedAutoDownloadNewEpisodes = settings.AutoDownloadNewEpisodes;
        selectedAutoDeleteRule = settings.AutoDeleteRule;
        selectedAutoDeleteAfterDays = settings.AutoDeleteAfterDays;

        StateHasChanged();
    }

    // Bookkeeping-only: the write already succeeded server-side, so a failure syncing our own
    // hash/lastSyncedAt shouldn't roll back the UI or report an error — the next poll would just
    // (harmlessly) treat this device's own write as a remote update instead.
    private async Task SyncOwnWriteBestEffortAsync()
    {
        if (syncStatusService is not null)
        {
            try
            {
                await syncStatusService.SyncOwnWriteAsync();
            }
            catch (HttpRequestException)
            {
            }
        }
    }

    private async Task OnUnlistenedEpisodeCountChangedAsync(ChangeEventArgs args)
    {
        if (!Enum.TryParse<UnlistenedEpisodeCount>(args.Value?.ToString(), out var value) || !Enum.IsDefined(value))
        {
            return;
        }

        var previous = selectedUnlistenedEpisodeCount;
        selectedUnlistenedEpisodeCount = value;
        isSaving = true;
        saveError = null;
        showSavedConfirmation = false;

        try
        {
            await SettingsClient.UpdateUnlistenedEpisodeCountAsync(value);
            showSavedConfirmation = true;
        }
        catch (HttpRequestException)
        {
            selectedUnlistenedEpisodeCount = previous;
            saveError = "Something went wrong while saving. Please try again.";
        }
        finally
        {
            isSaving = false;
        }

        await SyncOwnWriteBestEffortAsync();
    }

    private async Task OnAutoArchiveRuleChangedAsync(ChangeEventArgs args)
    {
        if (!Enum.TryParse<AutoArchiveRule>(args.Value?.ToString(), out var value) || !Enum.IsDefined(value))
        {
            return;
        }

        var previous = selectedAutoArchiveRule;
        selectedAutoArchiveRule = value;
        isArchiveSaving = true;
        archiveSaveError = null;
        archiveSaveSavedConfirmation = false;

        try
        {
            await SettingsClient.UpdateAutoArchiveRuleAsync(value);
            archiveSaveSavedConfirmation = true;
        }
        catch (HttpRequestException)
        {
            selectedAutoArchiveRule = previous;
            archiveSaveError = "Something went wrong while saving. Please try again.";
        }
        finally
        {
            isArchiveSaving = false;
        }

        await SyncOwnWriteBestEffortAsync();
    }

    private async Task OnAutoSkipIntroSecondsChangedAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var value))
        {
            return;
        }

        await SaveAutoSkipAsync(introSeconds: value, outroSeconds: selectedAutoSkipOutroSeconds);
    }

    private async Task OnAutoSkipOutroSecondsChangedAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var value))
        {
            return;
        }

        await SaveAutoSkipAsync(introSeconds: selectedAutoSkipIntroSeconds, outroSeconds: value);
    }

    private async Task SaveAutoSkipAsync(int introSeconds, int outroSeconds)
    {
        // Guards against the intro and outro selects racing each other. The lock ensures at most
        // one PUT /api/settings/auto-skip is in flight at a time, so requests always reach the
        // server in order and an older one can never finish after (and overwrite) a newer one.
        // The version check drops a call that was superseded while it waited for the lock —
        // whichever call is last to acquire the lock already holds the latest selected values, so
        // an earlier queued call has nothing left to contribute and must not send a stale PUT.
        var requestVersion = ++autoSkipSaveVersion;
        var previousIntro = selectedAutoSkipIntroSeconds;
        var previousOutro = selectedAutoSkipOutroSeconds;
        selectedAutoSkipIntroSeconds = introSeconds;
        selectedAutoSkipOutroSeconds = outroSeconds;
        isAutoSkipSaving = true;
        autoSkipSaveError = null;
        autoSkipSaveSavedConfirmation = false;

        await autoSkipSaveLock.WaitAsync();
        try
        {
            if (requestVersion != autoSkipSaveVersion)
            {
                return;
            }

            await SettingsClient.UpdateAutoSkipAsync(introSeconds, outroSeconds);
            autoSkipSaveSavedConfirmation = true;
        }
        catch (HttpRequestException)
        {
            selectedAutoSkipIntroSeconds = previousIntro;
            selectedAutoSkipOutroSeconds = previousOutro;
            autoSkipSaveError = "Something went wrong while saving. Please try again.";
        }
        finally
        {
            autoSkipSaveLock.Release();
            if (requestVersion == autoSkipSaveVersion)
            {
                isAutoSkipSaving = false;
            }
        }

        await SyncOwnWriteBestEffortAsync();
    }

    private async Task OnPlaybackSpeedChangedAsync(ChangeEventArgs args)
    {
        if (!float.TryParse(
                args.Value?.ToString(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var value) ||
            !float.IsFinite(value))
        {
            // NumberStyles.Float accepts "NaN"/"Infinity" as valid input, which the <select>'s
            // own values never are — but a tampered DOM value could still submit one, and
            // System.Text.Json throws (not HttpRequestException) trying to serialize either into
            // the PUT body, which would bypass the catch below and leave no revert/error shown.
            return;
        }

        var previous = selectedPlaybackSpeed;
        selectedPlaybackSpeed = value;
        isPlaybackSpeedSaving = true;
        playbackSpeedSaveError = null;
        playbackSpeedSaveSavedConfirmation = false;

        try
        {
            await SettingsClient.UpdatePlaybackSpeedAsync(value);
            playbackSpeedSaveSavedConfirmation = true;
        }
        catch (HttpRequestException)
        {
            selectedPlaybackSpeed = previous;
            playbackSpeedSaveError = "Something went wrong while saving. Please try again.";
        }
        finally
        {
            isPlaybackSpeedSaving = false;
        }

        await SyncOwnWriteBestEffortAsync();
    }

    private async Task OnSmartSpeedChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value is bool boolValue && boolValue;
        var previous = selectedSmartSpeed;
        selectedSmartSpeed = value;
        isSmartSpeedSaving = true;
        smartSpeedSaveError = null;
        smartSpeedSaveSavedConfirmation = false;

        try
        {
            await SettingsClient.UpdateSmartSpeedAsync(value);
            smartSpeedSaveSavedConfirmation = true;
        }
        catch (HttpRequestException)
        {
            selectedSmartSpeed = previous;
            smartSpeedSaveError = "Something went wrong while saving. Please try again.";
        }
        finally
        {
            isSmartSpeedSaving = false;
        }

        await SyncOwnWriteBestEffortAsync();
    }

    private async Task OnPlayNextBehaviorChangedAsync(ChangeEventArgs args)
    {
        if (!Enum.TryParse<PlayNextBehavior>(args.Value?.ToString(), out var value) || !Enum.IsDefined(value))
        {
            return;
        }

        var previous = selectedPlayNextBehavior;
        selectedPlayNextBehavior = value;
        isPlayNextSaving = true;
        playNextSaveError = null;
        playNextSaveSavedConfirmation = false;

        try
        {
            await SettingsClient.UpdatePlayNextBehaviorAsync(value);
            playNextSaveSavedConfirmation = true;
        }
        catch (HttpRequestException)
        {
            selectedPlayNextBehavior = previous;
            playNextSaveError = "Something went wrong while saving. Please try again.";
        }
        finally
        {
            isPlayNextSaving = false;
        }

        await SyncOwnWriteBestEffortAsync();
    }

    private async Task OnSleepTimerDefaultDurationChangedAsync(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString();
        if (string.IsNullOrEmpty(raw))
        {
            // "Not set" selected — the API's update endpoint only ever sets a concrete duration
            // (see SleepTimerDurationUi's doc comment), so there's nothing to save here; this
            // option only exists to represent a value this page never sends a PUT for.
            return;
        }
        if (!int.TryParse(raw, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            return;
        }

        var previous = selectedSleepTimerDefaultDurationMinutes;
        selectedSleepTimerDefaultDurationMinutes = value;
        isSleepTimerDefaultDurationSaving = true;
        sleepTimerDefaultDurationSaveError = null;
        sleepTimerDefaultDurationSaveSavedConfirmation = false;

        try
        {
            await SettingsClient.UpdateSleepTimerDefaultDurationAsync(value);
            sleepTimerDefaultDurationSaveSavedConfirmation = true;
        }
        catch (HttpRequestException)
        {
            selectedSleepTimerDefaultDurationMinutes = previous;
            sleepTimerDefaultDurationSaveError = "Something went wrong while saving. Please try again.";
        }
        finally
        {
            isSleepTimerDefaultDurationSaving = false;
        }

        await SyncOwnWriteBestEffortAsync();
    }

