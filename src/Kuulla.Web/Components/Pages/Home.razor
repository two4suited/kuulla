@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Kuulla.Web.Models
@using Kuulla.Web.Services
@inject SubscriptionClient SubscriptionClient
@inject PlaylistClient PlaylistClient
@inject EpisodeStateClient EpisodeStateClient
@inject NavigationManager Navigation

<PageTitle>Library</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>Library</h1>

        <h2 class="h5 text-muted mt-4">Playlists</h2>
        @if (isLoadingPlaylists)
        {
            <p>Loading&hellip;</p>
        }
        else if (playlistsLoadError is not null)
        {
            <p class="text-danger">@playlistsLoadError</p>
        }
        else
        {
            <div class="d-flex flex-row flex-nowrap gap-3 overflow-auto pb-2 mb-4" style="scroll-snap-type: x proximity;">
                <a href="up-next" class="card text-center text-decoration-none text-body flex-shrink-0" style="width: 8rem; scroll-snap-align: start;">
                    <div class="card-body">
                        <div class="fs-3">▶</div>
                        <div class="small mt-1">Up Next</div>
                    </div>
                </a>
                @foreach (var playlist in playlists)
                {
                    <a href="@($"playlists/{playlist.Id}")" class="card text-center text-decoration-none text-body flex-shrink-0"
                       style="width: 8rem; scroll-snap-align: start;">
                        <div class="card-body">
                            <div class="fs-3">🎵</div>
                            <div class="small mt-1 text-truncate">@playlist.Name</div>
                            <div class="text-muted" style="font-size: 0.7rem;">
                                @playlist.Items.Count episode@(playlist.Items.Count == 1 ? "" : "s")
                            </div>
                        </div>
                    </a>
                }
                <div class="card text-center flex-shrink-0" style="width: 8rem; opacity: 0.6; scroll-snap-align: start;" title="Coming soon">
                    <div class="card-body">
                        <div class="fs-3">⬇</div>
                        <div class="small mt-1">Downloaded</div>
                        <div class="text-muted" style="font-size: 0.7rem;">Coming soon</div>
                    </div>
                </div>
            </div>
        }

        <h2 class="h5 text-muted mt-4">Shows</h2>
        @if (isLoadingShows)
        {
            <p>Loading&hellip;</p>
        }
        else if (showsLoadError is not null)
        {
            <p class="text-danger">@showsLoadError</p>
        }
        else if (subscriptions.Count == 0)
        {
            <p>You haven't subscribed to any shows yet. <a href="search">Find some shows</a> to get started.</p>
        }
        else
        {
            <div class="row row-cols-2 row-cols-md-4 g-4">
                @foreach (var subscription in subscriptions)
                {
                    <div class="col">
                        <a href="@($"shows/{subscription.ShowId}")" class="text-decoration-none text-body">
                            <div class="card h-100 position-relative">
                                <div class="position-absolute top-0 end-0 m-2 d-flex flex-column align-items-end gap-1">
                                    @if (unplayedCounts.TryGetValue(subscription.ShowId, out var unplayedCount))
                                    {
                                        <span class="badge bg-primary rounded-pill">
                                            @(unplayedCount.HitCap ? $"{unplayedCount.Count}+" : unplayedCount.Count)
                                        </span>
                                    }
                                    @if (inProgressShowIds.Contains(subscription.ShowId))
                                    {
                                        <span class="badge bg-info" title="You have an episode in progress">
                                            <span aria-hidden="true">◐</span> In progress
                                        </span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(subscription.ShowArtworkUrl))
                                {
                                    <img src="@subscription.ShowArtworkUrl" alt="@subscription.ShowTitle" class="card-img-top" />
                                }
                                <div class="card-body">
                                    <h6 class="card-title">@subscription.ShowTitle</h6>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </Authorized>
    <NotAuthorized>
        @* A logged-out visit to "/" is a marketing visit — show the landing page.
           Also reachable directly at /welcome. *@
        <Landing />
    </NotAuthorized>
</AuthorizeView>

@code {
    private readonly List<Subscription> subscriptions = [];
    private readonly List<Playlist> playlists = [];
    private readonly Dictionary<string, UnplayedCount> unplayedCounts = [];
    private IReadOnlySet<string> inProgressShowIds = new HashSet<string>();
    private bool isLoadingShows;
    private bool isLoadingPlaylists;
    private string? showsLoadError;
    private string? playlistsLoadError;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // AuthorizeView alone only gates rendering; without this check the data loads below would
        // still run (and fail with caught-but-wasted 401s) for anonymous visitors hitting "/".
        var authState = await AuthenticationStateTask!;
        if (authState.User.Identity?.IsAuthenticated is not true)
        {
            // Send logged-out visitors to the statically-rendered marketing page. The
            // <NotAuthorized> branch below renders <Landing /> too, so there's no blank
            // flash before this redirect lands.
            Navigation.NavigateTo("welcome");
            return;
        }

        await Task.WhenAll(LoadShowsAsync(), LoadPlaylistsAsync());
    }

    private async Task LoadShowsAsync()
    {
        isLoadingShows = true;
        try
        {
            var results = await SubscriptionClient.GetSubscriptionsAsync();
            subscriptions.AddRange(results.OrderBy(s => s.ShowTitle, StringComparer.OrdinalIgnoreCase));
        }
        catch (HttpRequestException)
        {
            showsLoadError = "Something went wrong while loading your shows. Please try again.";
        }
        finally
        {
            isLoadingShows = false;
        }

        // Kept outside the try/catch above on purpose: unplayed badges are supplementary, so a
        // hiccup computing them shouldn't hide the already-loaded show grid behind an error.
        if (showsLoadError is null)
        {
            try
            {
                foreach (var (showId, count) in await EpisodeStateClient.GetUnplayedCountsByShowAsync())
                {
                    unplayedCounts[showId] = count;
                }

                inProgressShowIds = await EpisodeStateClient.GetInProgressShowIdsAsync();
            }
            catch (HttpRequestException)
            {
            }
        }

        StateHasChanged();
    }

    private async Task LoadPlaylistsAsync()
    {
        isLoadingPlaylists = true;
        try
        {
            var results = await PlaylistClient.GetPlaylistsAsync();
            playlists.AddRange(results.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase));
        }
        catch (HttpRequestException)
        {
            playlistsLoadError = "Something went wrong while loading your playlists. Please try again.";
        }
        finally
        {
            isLoadingPlaylists = false;
        }

        StateHasChanged();
    }
}
