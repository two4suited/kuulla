@page "/subscriptions"
@rendermode InteractiveServer
@using Kuulla.Web.Models
@using Kuulla.Web.Services
@inject SubscriptionClient SubscriptionClient
@inject EpisodeStateClient EpisodeStateClient
@inject SettingsClient SettingsClient

<PageTitle>Subscriptions</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <h1 class="mb-0">Subscriptions</h1>
            @if (!isLoading && loadError is null && subscriptions.Count > 0)
            {
                <ShowDisplaySettings SortOrder="sortOrder" SortOrderChanged="OnSortOrderChangedAsync" IsSavingSortOrder="isSavingSortOrder"
                                     HideCaughtUpShows="hideCaughtUpShows" HideCaughtUpShowsChanged="OnHideCaughtUpShowsChangedAsync"
                                     IsSavingHideCaughtUpShows="isSavingHideCaughtUpShows"
                                     IconSize="iconSize" IconSizeChanged="OnIconSizeChanged" />
            }
        </div>

        @if (hideCaughtUpShowsError is not null)
        {
            <p class="text-danger small">@hideCaughtUpShowsError</p>
        }

        @if (sortOrderError is not null)
        {
            <p class="text-danger small">@sortOrderError</p>
        }

        @if (sortOrder == SubscriptionSortOrder.Manual && !isLoading && loadError is null && subscriptions.Count > 0)
        {
            <p class="text-muted small mb-2"><span aria-hidden="true">⠿</span> Drag a show to reorder. Your arrangement syncs across devices.</p>
        }
        @if (manualOrderError is not null)
        {
            <p class="text-danger small">@manualOrderError</p>
        }

        @if (isLoading)
        {
            <p>Loading&hellip;</p>
        }
        else if (loadError is not null)
        {
            <p class="text-danger">@loadError</p>
        }
        else if (subscriptions.Count == 0)
        {
            <p>You haven't subscribed to any shows yet.</p>
        }
        else
        {
            var ordered = SubscriptionSorting.Sort(subscriptions, sortOrder, manualOrder, ActiveShowIds, hideCaughtUpShows);
            var isManual = sortOrder == SubscriptionSortOrder.Manual;
            if (ordered.Count == 0)
            {
                <p class="text-muted">You're caught up on every show. Turn off <em>Hide caught-up shows</em> to see them all.</p>
            }
            <div class="row @iconSize.RowColsClass() g-4">
                @for (var i = 0; i < ordered.Count; i++)
                {
                    var index = i;
                    var subscription = ordered[index];
                    <div class="col" style="@(isManual ? "cursor: move;" : null)"
                         draggable="@(isManual ? "true" : null)"
                         @ondragstart="@(() => dragSourceIndex = index)"
                         @ondragend="@(() => dragSourceIndex = null)"
                         @ondragover:preventDefault="isManual"
                         @ondrop="@(() => OnManualDropAsync(index))">
                        <div class="card h-100 position-relative">
                            <div class="position-absolute top-0 end-0 m-2 d-flex flex-column align-items-end gap-1" style="pointer-events: none;">
                                @if (unplayedCounts.TryGetValue(subscription.ShowId, out var unplayedCount))
                                {
                                    <span class="badge bg-primary rounded-pill">
                                        @(unplayedCount.HitCap ? $"{unplayedCount.Count}+" : unplayedCount.Count)
                                    </span>
                                }
                                @if (inProgressShowIds.Contains(subscription.ShowId))
                                {
                                    <span class="badge bg-info" title="You have an episode in progress">
                                        <span aria-hidden="true">◐</span> In progress
                                    </span>
                                }
                            </div>
                            <a href="@($"shows/{subscription.ShowId}")" class="text-decoration-none text-body" draggable="false" @onclick:preventDefault="isManual">
                                @if (!string.IsNullOrEmpty(subscription.ShowArtworkUrl))
                                {
                                    <img src="@subscription.ShowArtworkUrl" alt="@subscription.ShowTitle" class="card-img" draggable="false" />
                                }
                                else
                                {
                                    <div class="card-body d-flex align-items-center justify-content-center text-center text-body">
                                        <h6 class="card-title mb-0">@subscription.ShowTitle</h6>
                                    </div>
                                }
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <h1>Subscriptions</h1>
        <p>You need to <a href="Account/Login">log in</a> to view this page.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private readonly List<Subscription> subscriptions = [];
    private readonly Dictionary<string, UnplayedCount> unplayedCounts = [];
    private IReadOnlySet<string> inProgressShowIds = new HashSet<string>();
    private bool isLoading;
    private string? loadError;
    private SubscriptionSortOrder sortOrder = SubscriptionSortOrder.Title;
    private bool isSavingSortOrder;
    private string? sortOrderError;
    private List<string> manualOrder = [];
    private int? dragSourceIndex;
    private string? manualOrderError;
    // Device-local tile size; the real value is read from localStorage by ShowIconSizeSelect on
    // its first render, which then raises OnIconSizeChanged.
    private ShowIconSize iconSize = ShowIconSizes.Default;
    private bool hideCaughtUpShows;
    private bool isSavingHideCaughtUpShows;
    private string? hideCaughtUpShowsError;
    private bool episodeStateLoaded;

    // Shows with at least one unplayed or in-progress episode — the complement of "caught up".
    // Null until the supplementary episode-state fetch has completed, so the grid never hides
    // or re-sinks shows on incomplete data.
    private IReadOnlySet<string>? ActiveShowIds =>
        episodeStateLoaded ? unplayedCounts.Keys.Concat(inProgressShowIds).ToHashSet() : null;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // AuthorizeView alone only gates rendering; without this check the data load below would
        // still run (and fail with a caught-but-wasted 401) for anonymous visitors.
        var authState = await AuthenticationStateTask!;
        if (authState.User.Identity?.IsAuthenticated is not true)
        {
            return;
        }

        isLoading = true;
        try
        {
            var results = await SubscriptionClient.GetSubscriptionsAsync();
            // Ordering is applied at render time via SubscriptionSorting.Sort(sortOrder).
            subscriptions.AddRange(results);
        }
        catch (HttpRequestException)
        {
            loadError = "Something went wrong while loading your subscriptions. Please try again.";
        }
        finally
        {
            isLoading = false;
        }

        try
        {
            var settings = await SettingsClient.GetSettingsAsync();
            sortOrder = settings.SubscriptionSortOrder;
            manualOrder = settings.SubscriptionManualOrder?.ToList() ?? [];
            hideCaughtUpShows = settings.HideCaughtUpShows;
        }
        catch (HttpRequestException)
        {
            // Non-fatal — the grid still renders in the default Title order.
        }

        // Kept outside the try/catch above on purpose: unplayed badges are supplementary, so a
        // hiccup computing them shouldn't hide the already-loaded subscriptions grid behind an error.
        if (loadError is null)
        {
            try
            {
                foreach (var (showId, count) in await EpisodeStateClient.GetUnplayedCountsByShowAsync())
                {
                    unplayedCounts[showId] = count;
                }

                inProgressShowIds = await EpisodeStateClient.GetInProgressShowIdsAsync();
                episodeStateLoaded = true;
            }
            catch (HttpRequestException)
            {
            }
        }
    }

    private void OnIconSizeChanged(ShowIconSize size) => iconSize = size;

    private async Task OnSortOrderChangedAsync(SubscriptionSortOrder newOrder)
    {
        if (newOrder == sortOrder)
        {
            return;
        }

        var previous = sortOrder;
        sortOrder = newOrder;
        isSavingSortOrder = true;
        sortOrderError = null;
        try
        {
            await SettingsClient.UpdateSubscriptionSortOrderAsync(newOrder);
        }
        catch (HttpRequestException)
        {
            sortOrder = previous;
            sortOrderError = "Couldn't save your sort choice. Please try again.";
        }
        finally
        {
            isSavingSortOrder = false;
        }
    }

    private async Task OnHideCaughtUpShowsChangedAsync(bool newValue)
    {
        if (newValue == hideCaughtUpShows)
        {
            return;
        }

        var previous = hideCaughtUpShows;
        hideCaughtUpShows = newValue;
        isSavingHideCaughtUpShows = true;
        hideCaughtUpShowsError = null;
        try
        {
            await SettingsClient.UpdateHideCaughtUpShowsAsync(newValue);
        }
        catch (HttpRequestException)
        {
            hideCaughtUpShows = previous;
            hideCaughtUpShowsError = "Couldn't save your choice. Please try again.";
        }
        finally
        {
            isSavingHideCaughtUpShows = false;
        }
    }

    private async Task OnManualDropAsync(int targetIndex)
    {
        var source = dragSourceIndex;
        dragSourceIndex = null;
        if (source is not { } from)
        {
            return;
        }

        // Rebuild the full ordered show-id list from the current visual order with the drag
        // applied, then send it wholesale (last-write-wins on the whole array, per #438).
        var ordered = SubscriptionSorting.Sort(subscriptions, sortOrder, manualOrder);
        if (SubscriptionSorting.ApplyManualMove(ordered, from, targetIndex) is not { } newOrder)
        {
            return;
        }

        var previous = manualOrder;
        manualOrder = newOrder.ToList();
        manualOrderError = null;
        try
        {
            await SettingsClient.UpdateSubscriptionManualOrderAsync(manualOrder);
        }
        catch (HttpRequestException)
        {
            manualOrder = previous;
            manualOrderError = "Couldn't save the new order. Please try again.";
        }
    }

}
