@page "/subscriptions"
@rendermode InteractiveServer
@using Kuulla.Web.Models
@using Kuulla.Web.Services
@inject SubscriptionClient SubscriptionClient
@inject EpisodeStateClient EpisodeStateClient

<PageTitle>Subscriptions</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>Subscriptions</h1>

        @if (isLoading)
        {
            <p>Loading&hellip;</p>
        }
        else if (loadError is not null)
        {
            <p class="text-danger">@loadError</p>
        }
        else if (subscriptions.Count == 0)
        {
            <p>You haven't subscribed to any shows yet.</p>
        }
        else
        {
            <div class="row row-cols-2 row-cols-md-4 g-4">
                @foreach (var subscription in subscriptions)
                {
                    <div class="col">
                        <div class="card h-100 position-relative">
                            @if (unplayedCounts.TryGetValue(subscription.ShowId, out var unplayedCount) && unplayedCount > 0)
                            {
                                <span class="badge bg-primary rounded-pill position-absolute top-0 end-0 m-2">
                                    @(unplayedCount >= NewEpisodesPerShowLimit ? $"{unplayedCount}+" : unplayedCount)
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(subscription.ShowArtworkUrl))
                            {
                                <a href="@($"shows/{subscription.ShowId}")">
                                    <img src="@subscription.ShowArtworkUrl" alt="@subscription.ShowTitle" class="card-img-top" />
                                </a>
                            }
                            <div class="card-body">
                                <a href="@($"shows/{subscription.ShowId}")" class="text-decoration-none">
                                    <h6 class="card-title">@subscription.ShowTitle</h6>
                                </a>
                                <p class="card-text text-muted small">@subscription.ShowAuthor</p>

                                @if (confirmingShowId == subscription.ShowId)
                                {
                                    <p class="small">Unsubscribe from @subscription.ShowTitle?</p>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-danger" disabled="@isBusy" @onclick="() => UnsubscribeAsync(subscription.ShowId)">
                                            Confirm
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" disabled="@isBusy" @onclick="() => confirmingShowId = null">
                                            Cancel
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmingShowId = subscription.ShowId">
                                        Unsubscribe
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (unsubscribeError is not null)
            {
                <p class="text-danger mt-3">@unsubscribeError</p>
            }
        }
    </Authorized>
    <NotAuthorized>
        <h1>Subscriptions</h1>
        <p>You need to <a href="Account/Login">log in</a> to view this page.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    // Mirrors SubscriptionService.NewEpisodesPerShow on the API — the new-episodes endpoint this
    // page cross-references for unplayed badges caps how many episodes it returns per show, so a
    // badge sitting at that cap means "at least this many," not necessarily exact.
    private const int NewEpisodesPerShowLimit = 10;

    private readonly List<Subscription> subscriptions = [];
    private readonly Dictionary<string, int> unplayedCounts = [];
    private bool isLoading;
    private string? loadError;
    private string? confirmingShowId;
    private bool isBusy;
    private string? unsubscribeError;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // AuthorizeView alone only gates rendering; without this check the data load below would
        // still run (and fail with a caught-but-wasted 401) for anonymous visitors.
        var authState = await AuthenticationStateTask!;
        if (authState.User.Identity?.IsAuthenticated is not true)
        {
            return;
        }

        isLoading = true;
        try
        {
            var results = await SubscriptionClient.GetSubscriptionsAsync();
            subscriptions.AddRange(results.OrderBy(s => s.ShowTitle, StringComparer.OrdinalIgnoreCase));
        }
        catch (HttpRequestException)
        {
            loadError = "Something went wrong while loading your subscriptions. Please try again.";
        }
        finally
        {
            isLoading = false;
        }

        // Kept outside the try/catch above on purpose: unplayed badges are supplementary, so a
        // hiccup computing them shouldn't hide the already-loaded subscriptions grid behind an error.
        if (loadError is null)
        {
            try
            {
                var newEpisodes = await EpisodeStateClient.GetNewEpisodesAsync();
                foreach (var group in newEpisodes.GroupBy(e => e.Episode.ShowId))
                {
                    // Auto-played episodes are "unseen" but already marked played, so they
                    // shouldn't count toward an "unplayed" badge — mirrors the New Episodes
                    // header badge and Library, which exclude them the same way.
                    var count = group.Count(e => !e.AutoPlayed);
                    if (count > 0)
                    {
                        unplayedCounts[group.Key] = count;
                    }
                }
            }
            catch (HttpRequestException)
            {
            }
        }
    }

    private async Task UnsubscribeAsync(string showId)
    {
        isBusy = true;
        unsubscribeError = null;
        var removed = subscriptions.FirstOrDefault(s => s.ShowId == showId);
        if (removed is not null)
        {
            subscriptions.Remove(removed);
        }
        confirmingShowId = null;

        try
        {
            await SubscriptionClient.UnsubscribeAsync(showId);
        }
        catch (HttpRequestException)
        {
            if (removed is not null)
            {
                subscriptions.Add(removed);
                subscriptions.Sort((a, b) => string.Compare(a.ShowTitle, b.ShowTitle, StringComparison.OrdinalIgnoreCase));
            }

            unsubscribeError = "Something went wrong while unsubscribing. Please try again.";
        }
        finally
        {
            isBusy = false;
        }
    }
}
