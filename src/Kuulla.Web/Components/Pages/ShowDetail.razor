    private static bool TryParseNullableInt(string? raw, out int? value)
    {
        if (string.IsNullOrEmpty(raw))
        {
            value = null;
            return true;
        }

        if (int.TryParse(raw, out var parsed))
        {
            value = parsed;
            return true;
        }

        value = null;
        return false;
    }

