    private async Task OnShowAutoDeleteRuleChangedAsync(AutoDeleteRule? value)
    {
        // Switching to "After N days" with no prior day-count override seeds 7, so the inline
        // input and the persisted override start from a concrete value (matches iOS).
        var afterDays = value == AutoDeleteRule.AfterDays
            ? showAutoDeleteAfterDaysOverride ?? 7
            : showAutoDeleteAfterDaysOverride;
        await SaveShowAutoDeleteAsync(value, afterDays);
    }

    private async Task OnShowAutoDeleteAfterDaysChangedAsync(ChangeEventArgs args)
    {
        if (!TryParseNullableInt(args.Value?.ToString(), out var value))
        {
            return;
        }

        await SaveShowAutoDeleteAsync(showAutoDeleteRuleOverride, value);
    }

