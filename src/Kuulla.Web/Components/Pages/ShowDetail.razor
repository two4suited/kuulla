                LoadMoreEpisodesAsync(),
                isAuthenticated ? LoadSubscriptionStatusAsync() : Task.CompletedTask,
                isAuthenticated ? LoadShowSettingsAsync() : Task.CompletedTask);
        }
    }

    private async Task LoadShowSettingsAsync()
    {
        // Kicked off together: the two reads are independent, and the global one only gates whether
        // the per-show insert-position control is shown.
        var showSettingsTask = SettingsClient.GetShowSettingsAsync(Id);
        var globalSettingsTask = SettingsClient.GetSettingsAsync();

        try
        {
            var settings = await showSettingsTask;
            showUnlistenedEpisodeCountOverride = settings.UnlistenedEpisodeCount;
            showAutoArchiveRuleOverride = settings.AutoArchiveRule;
            showAutoDownloadNewEpisodesOverride = settings.AutoDownloadNewEpisodes;
            showAutoAddNewEpisodesToUpNextOverride = settings.AutoAddNewEpisodesToUpNext;
            showUpNextInsertPositionOverride = settings.UpNextInsertPosition;
            showAutoDeleteRuleOverride = settings.AutoDeleteRule;
            showAutoDeleteAfterDaysOverride = settings.AutoDeleteAfterDays;
            showAutoSkipIntroSecondsOverride = settings.AutoSkipIntroSeconds;
            showAutoSkipOutroSecondsOverride = settings.AutoSkipOutroSeconds;
            showPlaybackSpeedOverride = settings.PlaybackSpeed;
            showSmartSpeedOverride = settings.SmartSpeed;
            showNotificationsEnabledOverride = settings.NotificationsEnabled;
        }
        catch (HttpRequestException)
        {
            showSettingsError = "Something went wrong while loading this show's settings. Please try again.";
        }

        // Separate try/catch: a failure here shouldn't block the rest of this show's settings from
        // loading, since the global value only gates whether the position control is shown.
        try
        {
            var global = await globalSettingsTask;
            globalAutoAddNewEpisodesToUpNext = global.AutoAddNewEpisodesToUpNext;
            globalAutoSkipIntroSeconds = global.AutoSkipIntroSeconds;
            globalAutoSkipOutroSeconds = global.AutoSkipOutroSeconds;
            globalPlaybackSpeed = global.PlaybackSpeed;
        }
        catch (HttpRequestException)
        {
            // Leave the global hints null / false; the position control stays hidden unless this
            // show has its own auto-add override turned on, and the stepper / slider just omit
            // the "(…)" resolved-value hint.
        }
    }

