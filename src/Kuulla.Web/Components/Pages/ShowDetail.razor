@page "/shows/{Id}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Kuulla.Web.Models
@using Kuulla.Web.Services
@inject PodcastCatalogClient CatalogClient
@inject SubscriptionClient SubscriptionClient
@inject SettingsClient SettingsClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject EpisodeStateClient EpisodeStateClient

<PageTitle>@(show?.Title ?? "Show")</PageTitle>

@if (isLoadingShow)
{
    <p>Loading&hellip;</p>
}
else if (showError is not null)
{
    <p class="text-danger">@showError</p>
}
else if (show is null)
{
    <p>Show not found.</p>
}
else
{
    <div class="d-flex mb-4">
        @if (!string.IsNullOrEmpty(show.ArtworkUrl))
        {
            <img src="@show.ArtworkUrl" alt="@show.Title" style="width: 12rem; height: 12rem;" class="rounded me-4" />
        }
        <div>
            <h1>@show.Title</h1>
            <p class="text-muted">@show.Author</p>
            @if (show.Categories.Count > 0)
            {
                <p>
                    @foreach (var category in show.Categories)
                    {
                        <span class="badge text-bg-secondary me-1">@category</span>
                    }
                </p>
            }
            @if (!string.IsNullOrEmpty(show.Description))
            {
                <p>@show.Description</p>
            }
            <AuthorizeView>
                <Authorized>
                    @if (isSubscribed)
                    {
                        <button class="btn btn-outline-danger" disabled="@isSubscriptionBusy" @onclick="UnsubscribeAsync">
                            Unsubscribe
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary" disabled="@isSubscriptionBusy" @onclick="SubscribeAsync">
                            Subscribe
                        </button>
                    }
                    @if (subscriptionError is not null)
                    {
                        <p class="text-danger mt-2">@subscriptionError</p>
                    }

                    @* Every per-show override lives behind this single gear, mirroring the iOS
                       "Podcast settings" toolbar menu (ShowDetailView.swift) and the Library /
                       Subscriptions gear from #497. No Bootstrap JS is loaded, so it's a
                       hand-rolled popover: a transparent full-viewport catcher closes it on an
                       outside click. All the save + optimistic-rollback wiring stays in @code. *@
                    <div class="show-settings position-relative d-inline-block mt-3">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ToggleShowSettings"
                                aria-haspopup="true" aria-expanded="@isShowSettingsOpen"
                                title="Podcast settings" aria-label="Podcast settings">
                            <span aria-hidden="true">⚙</span> Podcast settings
                        </button>

                        @if (isShowSettingsOpen)
                        {
                            @* Reuses the #497 backdrop rule — a transparent full-viewport click catcher. *@
                            <div class="show-display-settings-backdrop" @onclick="CloseShowSettings"></div>
                            <div class="show-settings-panel border rounded shadow p-3" role="dialog" aria-label="Podcast settings">

                    @* Each control can inherit the user's global default (a null override) or
                       set a per-show value. Boolean + short-list settings use a segmented
                       control, longer enums a radio list, and the continuous ones (auto-skip
                       seconds, playback speed) a stepper / slider over their real range —
                       replacing the row of look-alike <select>s from #500 (issue #504). *@
                    <div class="show-setting">
                        <div class="form-label mb-1">Unlistened episodes to show</div>
                        <SegmentedChoice TValue="UnlistenedEpisodeCount" Id="show-unlistened-episode-count"
                                         AriaLabel="Unlistened episodes to show" Disabled="isShowSettingsSaving"
                                         Options="UnlistenedEpisodeCountOptions"
                                         Value="showUnlistenedEpisodeCountOverride"
                                         ValueChanged="OnShowUnlistenedEpisodeCountChangedAsync" />
                        @if (showSettingsError is not null)
                        {
                            <p class="text-danger mt-1 mb-0">@showSettingsError</p>
                        }
                        else if (showSettingsSavedConfirmation)
                        {
                            <p class="text-success mt-1 mb-0">Saved.</p>
                        }
                    </div>

                    <div class="show-setting mt-3">
                        <div class="form-label mb-1">Auto-archive played episodes</div>
                        <RadioChoice TValue="AutoArchiveRule" Id="show-auto-archive-rule"
                                     AriaLabel="Auto-archive played episodes" Disabled="isShowArchiveSettingsSaving"
                                     Options="AutoArchiveRuleOptions"
                                     Value="showAutoArchiveRuleOverride"
                                     ValueChanged="OnShowAutoArchiveRuleChangedAsync" />
                        @if (showArchiveSettingsError is not null)
                        {
                            <p class="text-danger mt-1 mb-0">@showArchiveSettingsError</p>
                        }
                        else if (showArchiveSettingsSavedConfirmation)
                        {
                            <p class="text-success mt-1 mb-0">Saved.</p>
                        }
                    </div>

                    <div class="show-setting mt-3">
                        <div class="form-label mb-1">Auto-download new episodes</div>
                        <SegmentedChoice TValue="bool" Id="show-auto-download-new-episodes"
                                         AriaLabel="Auto-download new episodes" Disabled="isShowAutoDownloadSaving"
                                         Options="OnOffOptions"
                                         Value="showAutoDownloadNewEpisodesOverride"
                                         ValueChanged="OnShowAutoDownloadNewEpisodesChangedAsync" />
                        @if (showAutoDownloadError is not null)
                        {
                            <p class="text-danger mt-1 mb-0">@showAutoDownloadError</p>
                        }
                        else if (showAutoDownloadSavedConfirmation)
                        {
                            <p class="text-success mt-1 mb-0">Saved.</p>
                        }
                    </div>

                    <div class="show-setting mt-3">
                        <div class="form-label mb-1">Delete downloads</div>
                        <RadioChoice TValue="AutoDeleteRule" Id="show-auto-delete-rule"
                                     AriaLabel="Delete downloads" Disabled="isShowAutoDeleteSaving"
                                     Options="AutoDeleteRuleOptions"
                                     Value="showAutoDeleteRuleOverride"
                                     ValueChanged="OnShowAutoDeleteRuleChangedAsync" />
                        @if (showAutoDeleteRuleOverride == AutoDeleteRule.AfterDays)
                        {
                            <div class="mt-2 d-flex align-items-center gap-2">
                                <label class="form-label mb-0" for="show-auto-delete-after-days">After</label>
                                <input id="show-auto-delete-after-days" type="number" class="form-control" style="width: 6rem;"
                                       min="1" max="365" disabled="@isShowAutoDeleteSaving" value="@showAutoDeleteAfterDaysOverride"
                                       @onchange="OnShowAutoDeleteAfterDaysChangedAsync" />
                                <span>day(s)</span>
                            </div>
                        }
                        @if (showAutoDeleteError is not null)
                        {
                            <p class="text-danger mt-1 mb-0">@showAutoDeleteError</p>
                        }
                        else if (showAutoDeleteSavedConfirmation)
                        {
                            <p class="text-success mt-1 mb-0">Saved.</p>
                        }
                    </div>

                    <div class="show-setting mt-3">
                        <div class="form-label mb-1">Add new episodes to Up Next</div>
                        <SegmentedChoice TValue="bool" Id="show-auto-add-up-next"
                                         AriaLabel="Add new episodes to Up Next" Disabled="isShowAutoAddUpNextSaving"
                                         Options="OnOffOptions"
                                         Value="showAutoAddNewEpisodesToUpNextOverride"
                                         ValueChanged="OnShowAutoAddNewEpisodesToUpNextChangedAsync" />
                        @if (showAutoAddUpNextError is not null)
                        {
                            <p class="text-danger mt-1 mb-0">@showAutoAddUpNextError</p>
                        }
                        else if (showAutoAddUpNextSavedConfirmation)
                        {
                            <p class="text-success mt-1 mb-0">Saved.</p>
                        }

                        @if (showAutoAddNewEpisodesToUpNextOverride ?? globalAutoAddNewEpisodesToUpNext)
                        {
                            <div class="mt-2">
                                <div class="form-label mb-1">Add to</div>
                                <SegmentedChoice TValue="UpNextInsertPosition" Id="show-up-next-insert-position"
                                                 AriaLabel="Up Next insert position" Disabled="isShowUpNextInsertPositionSaving"
                                                 Options="UpNextInsertPositionOptions"
                                                 Value="showUpNextInsertPositionOverride"
                                                 ValueChanged="OnShowUpNextInsertPositionChangedAsync" />
                                @if (showUpNextInsertPositionError is not null)
                                {
                                    <p class="text-danger mt-1 mb-0">@showUpNextInsertPositionError</p>
                                }
                                else if (showUpNextInsertPositionSavedConfirmation)
                                {
                                    <p class="text-success mt-1 mb-0">Saved.</p>
                                }
                            </div>
                        }
                    </div>

                    <div class="show-setting mt-3">
                        <div class="form-label mb-1">Auto-skip intro</div>
                        <InheritableStepper Id="show-auto-skip-intro" AriaLabel="Auto-skip intro"
                                            Disabled="isShowAutoSkipSaving" Min="0" Max="600" Step="5"
                                            Format="AutoSkipDurationUi.Format" GlobalValue="globalAutoSkipIntroSeconds"
                                            Value="showAutoSkipIntroSecondsOverride"
                                            ValueChanged="OnShowAutoSkipIntroChangedAsync" />
                    </div>

                    <div class="show-setting mt-3">
                        <div class="form-label mb-1">Auto-skip outro</div>
                        <InheritableStepper Id="show-auto-skip-outro" AriaLabel="Auto-skip outro"
                                            Disabled="isShowAutoSkipSaving" Min="0" Max="600" Step="5"
                                            Format="AutoSkipDurationUi.Format" GlobalValue="globalAutoSkipOutroSeconds"
                                            Value="showAutoSkipOutroSecondsOverride"
                                            ValueChanged="OnShowAutoSkipOutroChangedAsync" />
                        @if (showAutoSkipError is not null)
                        {
                            <p class="text-danger mt-1 mb-0">@showAutoSkipError</p>
                        }
                        else if (showAutoSkipSavedConfirmation)
                        {
                            <p class="text-success mt-1 mb-0">Saved.</p>
                        }
                    </div>

                    <div class="show-setting mt-3">
                        <div class="form-label mb-1">Playback speed</div>
                        <InheritableSlider Id="show-playback-speed" AriaLabel="Playback speed"
                                           Disabled="isShowPlaybackSpeedSaving" Min="0.5f" Max="3.0f" Step="0.1f"
                                           Format="PlaybackSpeedUi.Format" GlobalValue="globalPlaybackSpeed"
                                           Value="showPlaybackSpeedOverride"
                                           ValueChanged="OnShowPlaybackSpeedChangedAsync" />
                        @if (showPlaybackSpeedError is not null)
                        {
                            <p class="text-danger mt-1 mb-0">@showPlaybackSpeedError</p>
                        }
                        else if (showPlaybackSpeedSavedConfirmation)
                        {
                            <p class="text-success mt-1 mb-0">Saved.</p>
                        }
                    </div>

                    <div class="show-setting mt-3">
                        <div class="form-label mb-1">SmartSpeed</div>
                        <SegmentedChoice TValue="bool" Id="show-smart-speed"
                                         AriaLabel="SmartSpeed" Disabled="isShowSmartSpeedSaving"
                                         Options="OnOffOptions"
                                         Value="showSmartSpeedOverride"
                                         ValueChanged="OnShowSmartSpeedChangedAsync" />
                        @if (showSmartSpeedError is not null)
                        {
                            <p class="text-danger mt-1 mb-0">@showSmartSpeedError</p>
                        }
                        else if (showSmartSpeedSavedConfirmation)
                        {
                            <p class="text-success mt-1 mb-0">Saved.</p>
                        }
                    </div>

                    <div class="show-setting mt-3">
                        <div class="form-label mb-1">Notifications</div>
                        <SegmentedChoice TValue="bool" Id="show-notifications-enabled"
                                         AriaLabel="Notifications" Disabled="isShowNotificationsSaving"
                                         Options="OnOffOptions"
                                         Value="showNotificationsEnabledOverride"
                                         ValueChanged="OnShowNotificationsEnabledChangedAsync" />
                        @if (showNotificationsError is not null)
                        {
                            <p class="text-danger mt-1 mb-0">@showNotificationsError</p>
                        }
                        else if (showNotificationsSavedConfirmation)
                        {
                            <p class="text-success mt-1 mb-0">Saved.</p>
                        }
                    </div>

                            </div>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <h2>Episodes</h2>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div class="btn-group" role="group" aria-label="Filter episodes">
            <button type="button" class="btn btn-sm btn-outline-primary @(selectedFilter == EpisodeFilter.All ? "active" : "")"
                    aria-pressed="@(selectedFilter == EpisodeFilter.All)" @onclick="() => SetFilter(EpisodeFilter.All)">
                All
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary @(selectedFilter == EpisodeFilter.Unfinished ? "active" : "")"
                    aria-pressed="@(selectedFilter == EpisodeFilter.Unfinished)" @onclick="() => SetFilter(EpisodeFilter.Unfinished)">
                Unfinished
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary @(selectedFilter == EpisodeFilter.Unplayed ? "active" : "")"
                    aria-pressed="@(selectedFilter == EpisodeFilter.Unplayed)" @onclick="() => SetFilter(EpisodeFilter.Unplayed)">
                Unplayed
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary @(selectedFilter == EpisodeFilter.InProgress ? "active" : "")"
                    aria-pressed="@(selectedFilter == EpisodeFilter.InProgress)" @onclick="() => SetFilter(EpisodeFilter.InProgress)">
                In Progress
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary disabled" style="opacity: 0.6;"
                    aria-disabled="true" aria-pressed="false" tabindex="-1" title="Coming soon">
                Downloaded
            </button>
        </div>

        <select class="form-select form-select-sm" style="width: auto;" value="@selectedSort.ToString()" @onchange="OnSortChanged">
            <option value="@EpisodeSortOrder.NewestFirst">Newest first</option>
            <option value="@EpisodeSortOrder.OldestFirst">Oldest first</option>
        </select>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="mb-3">
                @if (markAllConfirming)
                {
                    <span class="me-2">Mark every episode of this show as played?</span>
                    <button class="btn btn-sm btn-primary" disabled="@isMarkingAllPlayed" @onclick="MarkAllPlayedAsync">
                        Yes, mark all played
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@isMarkingAllPlayed"
                            @onclick="() => markAllConfirming = false">
                        Cancel
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="StartMarkAllPlayed">
                        Mark all played
                    </button>
                }
                @if (markAllPlayedError is not null)
                {
                    <p class="text-danger mt-1 mb-0">@markAllPlayedError</p>
                }
            </div>
        </Authorized>
    </AuthorizeView>

    @if (episodeError is not null)
    {
        <p class="text-danger">@episodeError</p>
    }
    else if (episodes.Count == 0 && !isLoadingEpisodes)
    {
        <p>No episodes found for this show.</p>
    }
    else if (DisplayedEpisodes.Count == 0 && !isLoadingEpisodes)
    {
        <p>
            No episodes match this filter.
            @if (continuationToken is not null)
            {
                <text>Try loading more episodes.</text>
            }
        </p>
    }

    <ul class="list-group mb-3">
        @foreach (var episode in DisplayedEpisodes)
        {
            var state = GetState(episode.Id);
            var isAutoPlayed = state?.AutoPlayed ?? false;
            var isPlayed = state is { Completed: true, AutoPlayed: false };
            var progressPercent = ProgressPercent(episode, state);
            <li class="list-group-item">
                <div class="d-flex gap-3">
                    @if (!string.IsNullOrEmpty(show.ArtworkUrl))
                    {
                        <img src="@show.ArtworkUrl" alt="" style="width: 3rem; height: 3rem;" class="rounded flex-shrink-0" />
                    }
                    <div class="flex-grow-1">
                        <a href="@($"shows/{Id}/episodes/{episode.Id}")" class="text-decoration-none">
                            <div class="fw-bold">@episode.Title</div>
                        </a>
                        <div class="text-muted small">
                            @if (episode.PublishedAt is { } publishedAt)
                            {
                                @publishedAt.ToLocalTime().ToString("MMM d, yyyy")
                                <text> &middot; </text>
                            }
                            @if (episode.Duration is { } duration)
                            {
                                @EpisodeFormatting.FormatDuration(duration)
                            }
                        </div>
                        @if (progressPercent is { } percent)
                        {
                            <div class="progress mt-1" role="progressbar" aria-label="Playback progress"
                                 aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100" style="height: 4px;">
                                <div class="progress-bar" style="width: @(percent)%;"></div>
                            </div>
                        }
                        <AuthorizeView>
                            <Authorized>
                                <div class="d-flex align-items-center gap-2 mt-1">
                                    @if (isAutoPlayed)
                                    {
                                        <span class="badge text-bg-success">Auto-marked played</span>
                                        <button class="btn btn-sm btn-outline-secondary" disabled="@restoringEpisodeIds.Contains(episode.Id)"
                                                @onclick="() => RestoreAsync(episode)">
                                            Restore
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" disabled="@togglingEpisodeIds.Contains(episode.Id)"
                                                @onclick="() => ToggleCompletedAsync(episode)">
                                            @(isPlayed ? "Mark as unplayed" : "Mark as played")
                                        </button>
                                        @if (isPlayed)
                                        {
                                            <span class="badge text-bg-success">Played</span>
                                        }
                                    }
                                    <AddToPlaylistButton EpisodeId="@episode.Id" ShowId="@Id" />
                                </div>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>
            </li>
        }
    </ul>

    @if (episodeStateError is not null)
    {
        <p class="text-danger">@episodeStateError</p>
    }

    @if (isLoadingEpisodes)
    {
        <p>Loading episodes&hellip;</p>
    }
    else if (continuationToken is not null)
    {
        <button class="btn btn-outline-primary" @onclick="LoadMoreEpisodesAsync">Load more</button>
    }
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private Show? show;
    private bool isLoadingShow;
    private string? showError;
    private readonly List<Episode> episodes = [];
    private string? continuationToken;
    private bool isLoadingEpisodes;
    private string? episodeError;
    private bool isSubscribed;
    private bool isSubscriptionBusy;
    private string? subscriptionError;
    private UnlistenedEpisodeCount? showUnlistenedEpisodeCountOverride;
    private bool isShowSettingsSaving;
    private string? showSettingsError;
    private bool showSettingsSavedConfirmation;
    private AutoArchiveRule? showAutoArchiveRuleOverride;
    private bool isShowArchiveSettingsSaving;
    private string? showArchiveSettingsError;
    private bool showArchiveSettingsSavedConfirmation;
    private bool? showAutoDownloadNewEpisodesOverride;
    private bool isShowAutoDownloadSaving;
    private string? showAutoDownloadError;
    private bool showAutoDownloadSavedConfirmation;
    private bool? showAutoAddNewEpisodesToUpNextOverride;
    private bool isShowAutoAddUpNextSaving;
    private string? showAutoAddUpNextError;
    private bool showAutoAddUpNextSavedConfirmation;
    private UpNextInsertPosition? showUpNextInsertPositionOverride;
    private bool isShowUpNextInsertPositionSaving;
    private string? showUpNextInsertPositionError;
    private bool showUpNextInsertPositionSavedConfirmation;
    // The show-position control only makes sense when new episodes are actually being auto-added,
    // which can be true via the global default with no per-show override — so we need the global
    // values here, not just the override.
    private bool globalAutoAddNewEpisodesToUpNext;
    // Resolved global values, shown as the "Global default (…)" hint on the stepper / slider and
    // used as the starting point when the user first overrides. Null until the global read lands.
    private int? globalAutoSkipIntroSeconds;
    private int? globalAutoSkipOutroSeconds;
    private float? globalPlaybackSpeed;
    private AutoDeleteRule? showAutoDeleteRuleOverride;
    private int? showAutoDeleteAfterDaysOverride;
    private bool isShowAutoDeleteSaving;
    private string? showAutoDeleteError;
    private bool showAutoDeleteSavedConfirmation;
    private int? showAutoSkipIntroSecondsOverride;
    private int? showAutoSkipOutroSecondsOverride;
    private bool isShowAutoSkipSaving;
    private string? showAutoSkipError;
    private bool showAutoSkipSavedConfirmation;
    private float? showPlaybackSpeedOverride;
    private bool isShowPlaybackSpeedSaving;
    private string? showPlaybackSpeedError;
    private bool showPlaybackSpeedSavedConfirmation;
    private bool? showSmartSpeedOverride;
    private bool isShowSmartSpeedSaving;
    private string? showSmartSpeedError;
    private bool showSmartSpeedSavedConfirmation;
    private bool? showNotificationsEnabledOverride;
    private bool isShowNotificationsSaving;
    private string? showNotificationsError;
    private bool showNotificationsSavedConfirmation;
    private readonly Dictionary<string, EpisodeState> episodeStatesById = [];
    private readonly HashSet<string> restoringEpisodeIds = [];
    private readonly HashSet<string> togglingEpisodeIds = [];
    private string? episodeStateError;
    private bool markAllConfirming;
    private bool isMarkingAllPlayed;
    private string? markAllPlayedError;
    private bool isAuthenticated;
    private EpisodeFilter selectedFilter = EpisodeFilter.Unfinished;
    private EpisodeSortOrder selectedSort = EpisodeSortOrder.NewestFirst;
    private bool isShowSettingsOpen;

    private enum EpisodeFilter { All, Unfinished, Unplayed, InProgress }

    private enum EpisodeSortOrder { NewestFirst, OldestFirst }

    // Option lists for the SegmentedChoice / RadioChoice controls. The tri-state booleans all
    // share OnOffOptions (the "Default" segment is rendered by the component itself).
    private static readonly IReadOnlyList<(bool Value, string Label)> OnOffOptions =
        [(true, "On"), (false, "Off")];

    private static readonly IReadOnlyList<(UnlistenedEpisodeCount Value, string Label)> UnlistenedEpisodeCountOptions =
        [.. UnlistenedEpisodeCountUi.Options.Select(o => (o, UnlistenedEpisodeCountUi.Format(o)))];

    private static readonly IReadOnlyList<(AutoArchiveRule Value, string Label)> AutoArchiveRuleOptions =
        [.. AutoArchiveRuleUi.Options.Select(o => (o, AutoArchiveRuleUi.Format(o)))];

    private static readonly IReadOnlyList<(AutoDeleteRule Value, string Label)> AutoDeleteRuleOptions =
        [.. AutoDeleteRuleUi.Options.Select(o => (o, AutoDeleteRuleUi.Format(o)))];

    private static readonly IReadOnlyList<(UpNextInsertPosition Value, string Label)> UpNextInsertPositionOptions =
        [(UpNextInsertPosition.Top, "Top of the queue"), (UpNextInsertPosition.Bottom, "Bottom of the queue")];

    // Filter/sort apply to whatever pages have been fetched so far — the API only supports
    // date-ordered continuation paging, not server-side filtering, so "Load more" always fetches
    // the next raw page regardless of the active filter (see LoadMoreEpisodesAsync).
    // Archived episodes are excluded from every filter, including "All" — auto-archiving is
    // meant to hide played episodes from the active list entirely (#187); there's no separate
    // "Archived" view yet to surface them.
    private List<Episode> DisplayedEpisodes
    {
        get
        {
            IEnumerable<Episode> active = episodes.Where(e => !IsArchived(e));
            IEnumerable<Episode> filtered = selectedFilter switch
            {
                EpisodeFilter.Unfinished => active.Where(e => IsUnplayed(e) || IsInProgress(e)),
                EpisodeFilter.Unplayed => active.Where(IsUnplayed),
                EpisodeFilter.InProgress => active.Where(IsInProgress),
                _ => active,
            };

            return (selectedSort == EpisodeSortOrder.OldestFirst ? filtered.Reverse() : filtered).ToList();
        }
    }

    private EpisodeState? GetState(string episodeId) => episodeStatesById.GetValueOrDefault(episodeId);

    private bool IsArchived(Episode episode) => GetState(episode.Id)?.Archived == true;

    private bool IsUnplayed(Episode episode)
    {
        var state = GetState(episode.Id);
        // Auto-played episodes are treated as played here — they show their own
        // "Auto-marked played" badge with a Restore action, so they shouldn't also
        // clutter the Unplayed filter/tab. Only episodes with no real progress
        // (the shape a Restore write leaves, or no state at all) count as unplayed.
        if (state is null)
        {
            return true;
        }

        return !state.AutoPlayed && !state.Completed && state.PositionSeconds == 0;
    }

    private bool IsInProgress(Episode episode)
    {
        var state = GetState(episode.Id);
        return state is { Completed: false, PositionSeconds: > 0 };
    }

    private static int? ProgressPercent(Episode episode, EpisodeState? state)
    {
        if (state is null || state.Completed || state.PositionSeconds <= 0 ||
            episode.Duration is not { } duration || duration <= TimeSpan.Zero)
        {
            return null;
        }

        var percent = (int)(state.PositionSeconds / duration.TotalSeconds * 100);
        return Math.Clamp(percent, 1, 99);
    }

    private void SetFilter(EpisodeFilter filter)
    {
        selectedFilter = filter;
    }

    private void ToggleShowSettings() => isShowSettingsOpen = !isShowSettingsOpen;

    private void CloseShowSettings() => isShowSettingsOpen = false;

    private void OnSortChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<EpisodeSortOrder>(args.Value?.ToString(), out var value))
        {
            selectedSort = value;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        show = null;
        showError = null;
        episodes.Clear();
        continuationToken = null;
        episodeError = null;
        isSubscribed = false;
        isSubscriptionBusy = false;
        subscriptionError = null;
        showUnlistenedEpisodeCountOverride = null;
        isShowSettingsSaving = false;
        showSettingsError = null;
        showSettingsSavedConfirmation = false;
        showAutoArchiveRuleOverride = null;
        isShowArchiveSettingsSaving = false;
        showArchiveSettingsError = null;
        showArchiveSettingsSavedConfirmation = false;
        showAutoDownloadNewEpisodesOverride = null;
        isShowAutoDownloadSaving = false;
        showAutoDownloadError = null;
        showAutoDownloadSavedConfirmation = false;
        showAutoAddNewEpisodesToUpNextOverride = null;
        isShowAutoAddUpNextSaving = false;
        showAutoAddUpNextError = null;
