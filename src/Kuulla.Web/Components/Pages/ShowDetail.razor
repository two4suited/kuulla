    // The API only paginates the raw, unfiltered episode list — DisplayedEpisodes applies the
    // active filter client-side afterward. Without this loop, a single "Load more" click can
    // fetch a page that the current filter drops entirely (e.g. a show marked all-played, viewed
    // under "Unfinished"), leaving the button visible with nothing new on screen and no way to
    // tell whether another click would ever help (#617). Keep fetching bounded, additional raw
    // pages until either something becomes visible under the filter or the raw pagination is
    // genuinely exhausted, so the button only lingers when there really is more to try.
    private const int MaxPagesPerLoadMore = 5;

    private async Task LoadMoreEpisodesAsync()
    {
        if (isLoadingEpisodes)
        {
            return;
        }

        isLoadingEpisodes = true;
        episodeError = null;

        try
        {
            for (var i = 0; i < MaxPagesPerLoadMore; i++)
            {
                var visibleCountBefore = DisplayedEpisodes.Count;
                var page = await CatalogClient.GetEpisodesAsync(Id, continuationToken, pageSize: 20);
                episodes.AddRange(page.Items);
                continuationToken = page.ContinuationToken;

                if (isAuthenticated)
                {
                    await LoadEpisodeStatesAsync(page.Items);
                }

                if (DisplayedEpisodes.Count > visibleCountBefore || continuationToken is null)
                {
                    break;
                }
            }
        }
        catch (HttpRequestException)
        {
            episodeError = "Something went wrong while loading episodes. Please try again.";
        }
        finally
        {
            isLoadingEpisodes = false;
        }
    }

    private async Task LoadEpisodeStatesAsync(IReadOnlyList<Episode> loadedEpisodes)
    {
        try
        {
            var states = await EpisodeStateClient.GetStatesAsync(loadedEpisodes.Select(e => e.Id).ToList());
            foreach (var (episodeId, state) in states)
            {
                episodeStatesById[episodeId] = state;
            }
        }
        catch (HttpRequestException)
        {
        }
    }

    private void StartMarkAllPlayed()
    {
        markAllConfirming = true;
        markAllPlayedError = null;
    }

    private async Task MarkAllPlayedAsync()
    {
        if (isMarkingAllPlayed)
        {
            return;
        }

        isMarkingAllPlayed = true;
        markAllPlayedError = null;

        try
        {
            var result = await EpisodeStateClient.MarkAllPlayedAsync(Id);
            foreach (var state in result.UpdatedStates)
            {
                episodeStatesById[state.EpisodeId] = state;
            }

            // Episodes on later, not-yet-loaded pages were marked server-side too; refetch state
            // for everything currently on screen so no visible row lingers as unplayed.
            await LoadEpisodeStatesAsync(episodes);
            markAllConfirming = false;
        }
        catch (HttpRequestException)
        {
            markAllPlayedError = "Something went wrong while marking episodes played. Please try again.";
        }
        finally
        {
            isMarkingAllPlayed = false;
        }
    }

    private async Task RestoreAsync(Episode episode)
    {
        episodeStateError = null;
        restoringEpisodeIds.Add(episode.Id);

        try
        {
            var updated = await EpisodeStateClient.UpdateStateAsync(episode.Id, Id, positionSeconds: 0, completed: false);
            episodeStatesById[episode.Id] = updated;
        }
        catch (HttpRequestException)
        {
            episodeStateError = "Something went wrong while restoring this episode. Please try again.";
        }
        finally
        {
            restoringEpisodeIds.Remove(episode.Id);
        }
    }

    private async Task ToggleCompletedAsync(Episode episode)
    {
        if (togglingEpisodeIds.Contains(episode.Id))
        {
            return;
        }

        togglingEpisodeIds.Add(episode.Id);
        episodeStateError = null;

        try
        {
            var state = GetState(episode.Id);
            var newCompleted = state is not { Completed: true, AutoPlayed: false };
            var positionSeconds = newCompleted ? (int)(episode.Duration ?? TimeSpan.Zero).TotalSeconds : state?.PositionSeconds ?? 0;
            var updated = await EpisodeStateClient.UpdateStateAsync(episode.Id, Id, positionSeconds, newCompleted);
            episodeStatesById[episode.Id] = updated;
        }
        catch (HttpRequestException)
        {
            episodeStateError = "Something went wrong while updating this episode. Please try again.";
        }
        finally
        {
            togglingEpisodeIds.Remove(episode.Id);
        }
    }
