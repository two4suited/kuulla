@page "/playlists"
@rendermode InteractiveServer
@using Kuulla.Web.Models
@using Kuulla.Web.Services
@inject PlaylistClient PlaylistClient

<PageTitle>Playlists</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>Playlists</h1>

        <div class="mb-4" style="max-width: 24rem;">
            <div class="btn-group mb-2" role="group">
                <button type="button" class="btn btn-sm @(playlistType == PlaylistType.Manual ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SelectPlaylistType(PlaylistType.Manual)">
                    Manual
                </button>
                <button type="button" class="btn btn-sm @(playlistType == PlaylistType.Dynamic ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SelectPlaylistType(PlaylistType.Dynamic)">
                    Dynamic
                </button>
            </div>

            @if (playlistType == PlaylistType.Manual)
            {
                <div class="d-flex gap-2 mb-2">
                    <input class="form-control" placeholder="New playlist name" @bind="newPlaylistName" @bind:event="oninput"
                           disabled="@isCreating" @onkeydown="OnNewPlaylistNameKeyDownAsync" />
                    <button class="btn btn-primary text-nowrap" disabled="@(isCreating || string.IsNullOrWhiteSpace(newPlaylistName))"
                            @onclick="CreateManualPlaylistAsync">
                        Create
                    </button>
                </div>
                <PlaylistAppearancePicker @bind-Icon="newPlaylistIcon" @bind-AccentColor="newPlaylistAccentColor" />
            }
            else
            {
                <input class="form-control mb-3" placeholder="New playlist name" @bind="newPlaylistName" @bind:event="oninput" />

                @if (string.IsNullOrWhiteSpace(newPlaylistName))
                {
                    <p class="text-muted small">Enter a name to configure this playlist.</p>
                }
                else
                {
                    <PlaylistAppearancePicker @bind-Icon="newPlaylistIcon" @bind-AccentColor="newPlaylistAccentColor" />
                    <DynamicPlaylistConfigEditor SaveLabel="Create Dynamic Playlist" OnSave="CreateDynamicPlaylistAsync" />
                }
            }
        </div>
        @if (createError is not null)
        {
            <p class="text-danger">@createError</p>
        }

        @if (isLoading)
        {
            <p>Loading&hellip;</p>
        }
        else if (loadError is not null)
        {
            <p class="text-danger">@loadError</p>
        }
        else if (playlists.Count == 0)
        {
            <p>You haven't created any playlists yet.</p>
        }
        else
        {
            <div class="list-group" style="max-width: 32rem;">
                @foreach (var playlist in playlists)
                {
                    <a href="@($"playlists/{playlist.Id}")" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(playlist.Icon))
                            {
                                <span aria-hidden="true" style="@AccentStyle(playlist.AccentColor)">@playlist.Icon</span>
                            }
                            <span>@playlist.Name</span>
                        </span>
                        <span class="text-muted small">@playlist.Items.Count episode@(playlist.Items.Count == 1 ? "" : "s")</span>
                    </a>
                }
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <h1>Playlists</h1>
        <p>You need to <a href="Account/Login">log in</a> to view this page.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private readonly List<Playlist> playlists = [];
    private bool isLoading;
    private string? loadError;
    private string newPlaylistName = "";
    private string? newPlaylistIcon;
    private string? newPlaylistAccentColor;
    private bool isCreating;
    private string? createError;
    private PlaylistType playlistType = PlaylistType.Manual;

    // A playlist accent colour tints its icon glyph in list rows and the detail header. Kept to
    // the glyph (not the whole row) so a strong swatch doesn't fight the surrounding text.
    private static string AccentStyle(string? accentColor) =>
        string.IsNullOrEmpty(accentColor) ? "" : $"color: {accentColor};";

    private void SelectPlaylistType(PlaylistType type)
    {
        playlistType = type;
        // Otherwise a stale error from the previous creation flow (e.g. a failed manual create)
        // stays visible while configuring the other flow.
        createError = null;
    }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        if (authState.User.Identity?.IsAuthenticated is not true)
        {
            return;
        }

        isLoading = true;
        try
        {
            var results = await PlaylistClient.GetPlaylistsAsync();
            playlists.AddRange(results.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase));
        }
        catch (HttpRequestException)
        {
            loadError = "Something went wrong while loading your playlists. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnNewPlaylistNameKeyDownAsync(KeyboardEventArgs args)
    {
        if (playlistType == PlaylistType.Manual && args.Key == "Enter" && !isCreating && !string.IsNullOrWhiteSpace(newPlaylistName))
        {
            await CreateManualPlaylistAsync();
        }
    }

    private async Task CreateManualPlaylistAsync()
    {
        var name = newPlaylistName.Trim();
        if (name.Length == 0 || isCreating)
        {
            return;
        }

        isCreating = true;
        createError = null;

        try
        {
            var created = await PlaylistClient.CreatePlaylistAsync(name, newPlaylistIcon, newPlaylistAccentColor);
            AddCreatedPlaylist(created);
        }
        catch (HttpRequestException)
        {
            createError = "Something went wrong while creating this playlist. Please try again.";
        }
        finally
        {
            isCreating = false;
        }
    }

    // Left to throw on failure — DynamicPlaylistConfigEditor's own SaveAsync catches
    // HttpRequestException and surfaces its inline saveError, so this doesn't need its own
    // try/catch (matching PlaylistDetail.SaveDynamicConfigAsync's approach for the same editor).
    private async Task CreateDynamicPlaylistAsync(DynamicPlaylistConfig config)
    {
        var name = newPlaylistName.Trim();
        if (name.Length == 0)
        {
            return;
        }

        var created = await PlaylistClient.CreateDynamicPlaylistAsync(name, config, newPlaylistIcon, newPlaylistAccentColor);
        AddCreatedPlaylist(created);
        playlistType = PlaylistType.Manual;
    }

    private void AddCreatedPlaylist(Playlist created)
    {
        playlists.Add(created);
        playlists.Sort((a, b) => string.Compare(a.Name, b.Name, StringComparison.OrdinalIgnoreCase));
        newPlaylistName = "";
        newPlaylistIcon = null;
        newPlaylistAccentColor = null;
    }
}
