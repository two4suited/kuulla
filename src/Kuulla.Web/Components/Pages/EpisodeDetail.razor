@page "/shows/{ShowId}/episodes/{EpisodeId}"
@implements IAsyncDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Kuulla.Web.Models
@using Kuulla.Web.Services
@inject PodcastCatalogClient CatalogClient
@inject EpisodeStateClient EpisodeStateClient
@inject SettingsClient SettingsClient
@inject IJSRuntime JS

<PageTitle>@(episode?.Title ?? "Episode")</PageTitle>

@if (isLoading)
{
    <p>Loading&hellip;</p>
}
else if (loadError is not null)
{
    <p class="text-danger">@loadError</p>
}
else if (episode is null)
{
    <p>Episode not found.</p>
}
else
{
    <a href="@($"shows/{ShowId}")" class="d-inline-block mb-3">&larr; Back to show</a>

    <div class="d-flex align-items-center gap-2 mb-1">
        <h1 class="mb-0">@episode.Title</h1>
        <span class="badge @StatusBadgeClass">@StatusLabel</span>
    </div>

    <div class="k-meta mb-3">
        @if (episode.PublishedAt is { } publishedAt)
        {
            @publishedAt.ToLocalTime().ToString("MMM d, yyyy")
            <text> &middot; </text>
        }
        @if (episode.Duration is { } duration)
        {
            @EpisodeFormatting.FormatDuration(duration)
        }
    </div>

    <audio @ref="audioElement" controls preload="none" class="w-100 mb-2">
        <source src="@episode.AudioUrl" />
        Your browser does not support the audio element.
    </audio>

    <div class="d-flex align-items-center gap-2 mb-2">
        <label for="playback-speed" class="form-label mb-0 small text-muted">Speed</label>
        <select id="playback-speed" class="form-select form-select-sm w-auto" disabled="@isPlaybackSpeedSaving"
                value="@playbackSpeed.ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="OnPlaybackSpeedChangedAsync">
            @foreach (var option in PlaybackSpeedUi.OptionsIncluding(playbackSpeed))
            {
                <option value="@option.ToString(System.Globalization.CultureInfo.InvariantCulture)">@PlaybackSpeedUi.Format(option)</option>
            }
        </select>
        @if (playbackSpeedError is not null)
        {
            <span class="text-danger small">@playbackSpeedError</span>
        }
    </div>

    @if (resumePrompt is not null)
    {
        <div class="alert alert-info d-flex flex-wrap align-items-center gap-2 py-2" role="alert">
            <span class="me-auto">
                You left off at @EpisodeFormatting.FormatDuration(TimeSpan.FromSeconds(resumePrompt.OtherDevicePositionSeconds)) on another device.
            </span>
            <button type="button" class="btn btn-sm btn-primary" @onclick="ResumeFromOtherDeviceAsync">Resume</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DismissResumePromptAsync">Not now</button>
        </div>
    }

    @if (handoffBanner is not null)
    {
        <div class="alert alert-secondary d-flex flex-wrap align-items-center gap-2 py-2" role="status">
            <span class="me-auto">
                Now playing on another device &mdash; jump to @EpisodeFormatting.FormatDuration(TimeSpan.FromSeconds(handoffBanner.TargetPositionSeconds))?
            </span>
            <button type="button" class="btn btn-sm btn-primary" @onclick="JumpToHandoffAsync">Jump here</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Dismiss" @onclick="DismissHandoffBanner">&times;</button>
        </div>
    }

    @if (streamBlockedMessage is not null)
    {
        <p class="text-danger small mb-2">@streamBlockedMessage</p>
    }

    <div class="d-flex align-items-center gap-2 mb-4">
        <button class="btn btn-sm btn-outline-secondary" disabled="@isTogglingCompleted" @onclick="ToggleCompletedAsync">
            @(isAutoPlayed ? "Restore" : isCompleted ? "Mark as unplayed" : "Mark as played")
        </button>
        <AuthorizeView>
            <Authorized>
                <AddToPlaylistButton EpisodeId="@EpisodeId" ShowId="@ShowId" />
            </Authorized>
        </AuthorizeView>
    </div>

    @if (stateError is not null)
    {
        <p class="text-danger">@stateError</p>
    }

    @if (episode.Chapters is { Count: > 0 } chapters)
    {
        <h2>Chapters</h2>
        <ul class="list-group mb-4">
            @foreach (var chapter in chapters)
            {
                <li class="list-group-item d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(chapter.ImageUrl))
                    {
                        <img src="@chapter.ImageUrl" alt="" width="40" height="40" class="rounded flex-shrink-0" style="object-fit: cover;" />
                    }
                    <button type="button" class="btn btn-link text-start flex-grow-1 text-decoration-none p-0" @onclick="() => SeekToAsync(chapter.StartTime)">
                        @chapter.Title
                    </button>
                    <span class="text-muted small font-monospace flex-shrink-0">@EpisodeFormatting.FormatDuration(chapter.StartTime)</span>
                </li>
            }
        </ul>
    }

    @if (ShowTranscriptSection)
    {
        <h2>Transcript</h2>
        @if (isTranscriptLoading)
        {
            <p class="text-muted">Loading transcript&hellip;</p>
        }
        else if (transcript is { Segments.Count: > 0 })
        {
            var filtered = FilteredSegments;

            <input type="search" class="form-control mb-2" placeholder="Search transcript"
                   @bind="transcriptSearch" @bind:event="oninput" aria-label="Search transcript" />

            @if (!string.IsNullOrWhiteSpace(transcriptSearch))
            {
                <p class="text-muted small mb-2">
                    @filtered.Count @(filtered.Count == 1 ? "match" : "matches")
                </p>
            }

            @if (filtered.Count == 0)
            {
                <p class="text-muted mb-4">No matching lines.</p>
            }
            else
            {
                <ol class="list-unstyled mb-4">
                    @foreach (var segment in filtered)
                    {
                        <li class="d-flex gap-2 mb-1">
                            <button type="button"
                                    class="btn btn-link p-0 text-decoration-none flex-shrink-0 font-monospace small align-self-start"
                                    @onclick="() => SeekToAsync(segment.StartTime)">
                                @EpisodeFormatting.FormatDuration(segment.StartTime)
                            </button>
                            <span>
                                @foreach (var part in HighlightMatches(segment.Text, transcriptSearch))
                                {
                                    if (part.Highlight)
                                    {
                                        <mark>@part.Text</mark>
                                    }
                                    else
                                    {
                                        @part.Text
                                    }
                                }
                            </span>
                        </li>
                    }
                </ol>
            }
        }
        else
        {
            <p class="text-muted mb-4">Transcript couldn&rsquo;t be loaded.</p>
        }
    }

    @if (!string.IsNullOrEmpty(episode.Description))
    {
        <h2>Show notes</h2>
        <p style="white-space: pre-wrap;">@episode.Description</p>
    }
    else
    {
        <p class="text-muted">No show notes available for this episode.</p>
    }
}

@code {
    [Parameter]
    public string ShowId { get; set; } = "";

    [Parameter]
    public string EpisodeId { get; set; } = "";

    private Episode? episode;
    private bool isLoading;
    private string? loadError;

    private ElementReference audioElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _watcher;
    private DotNetObjectReference<EpisodeDetail>? _selfReference;

    // Effective playback speed for this episode (#443): the per-show ShowSettings.PlaybackSpeed
    // override if set, else the global UserSettings.PlaybackSpeed, else 1.0 — matching the iOS
    // resolution order in EpisodeDetailView.loadPlaybackSettings(). Seeded into the JS watcher on
    // attach and adjustable live from the speed selector.
    private float playbackSpeed = 1.0f;
    private bool isPlaybackSpeedSaving;
    private string? playbackSpeedError;

    private int savedPositionSeconds;
    private bool isCompleted;
    private bool isAutoPlayed;
    private bool isTogglingCompleted;
    private string? stateError;
    private string? streamBlockedMessage;

    // The synced state as last fetched, kept so OnAfterRenderAsync can compare it against this
    // browser's localStorage record for the cross-device resume prompt (#243).
    private EpisodeState? episodeState;
    // Non-null while the "resume from another device" prompt is shown.
    private CrossDeviceResume.Prompt? resumePrompt;

    // Non-null while the mid-playback "now playing on another device" banner (#244) is shown.
    private CrossDeviceHandoff.Banner? handoffBanner;
    // The stored UpdatedAt of the last remote write already surfaced via the handoff banner.
    private DateTimeOffset? lastSurfacedHandoffUpdatedAt;
    // Set when the user dismisses the handoff banner — suppresses it for the rest of this
    // viewing; reset only when a different episode loads (OnParametersSetAsync).
    private bool handoffDismissed;
    // Drives the poll-while-playing loop (#244); cancelled on pause, navigation, and dispose.
    private CancellationTokenSource? _handoffPollCts;

    private TranscriptDocument? transcript;
    private bool isTranscriptLoading;
    private bool transcriptLoadFailed;
    private string transcriptSearch = "";

    // Bumped on every OnParametersSetAsync so the fire-and-forget transcript load can tell whether
    // its episode is still the one on screen before writing its result back.
    private int _loadGeneration;

    // Shown once the episode advertises a transcript AND we have something to render for it —
    // segments, a spinner, or a load failure. A transcript tag whose document the API couldn't
    // turn into segments (404, no error) just renders nothing rather than an empty section.
    private bool ShowTranscriptSection =>
        episode?.TranscriptUrl is not null
        && (isTranscriptLoading || transcript is { Segments.Count: > 0 } || transcriptLoadFailed);

    private IReadOnlyList<TranscriptSegment> FilteredSegments
    {
        get
        {
            var segments = transcript?.Segments ?? [];
            return string.IsNullOrWhiteSpace(transcriptSearch)
                ? segments
                : segments.Where(s => s.Text.Contains(transcriptSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    // Serializes PersistStateAsync calls so overlapping triggers (pause firing just before ended,
    // or a timeupdate racing the manual toggle) apply in invocation order rather than completion
    // order — otherwise a slower earlier call's response could land after and overwrite a later
    // one's (e.g. a stale in-flight progress update clobbering a completed:true write).
    private readonly SemaphoreSlim _persistGate = new(1, 1);

    private string StatusLabel => isAutoPlayed ? "Auto-marked played"
        : isCompleted ? "Played"
        : savedPositionSeconds > 0 ? "In progress" : "New";

    private string StatusBadgeClass => isAutoPlayed ? "bg-success fst-italic"
        : isCompleted ? "bg-success"
        : savedPositionSeconds > 0 ? "bg-info text-dark" : "bg-secondary";

    protected override async Task OnParametersSetAsync()
    {
        await DisposeInteropAsync();

        _loadGeneration++;
        episode = null;
        loadError = null;
        savedPositionSeconds = 0;
        isCompleted = false;
        isAutoPlayed = false;
        episodeState = null;
        resumePrompt = null;
        handoffBanner = null;
        lastSurfacedHandoffUpdatedAt = null;
        handoffDismissed = false;
        streamBlockedMessage = null;
        playbackSpeed = 1.0f;
        playbackSpeedError = null;
        transcript = null;
        isTranscriptLoading = false;
        transcriptLoadFailed = false;
        transcriptSearch = "";
        isLoading = true;
        try
        {
            episode = await CatalogClient.GetEpisodeAsync(ShowId, EpisodeId);
        }
        catch (HttpRequestException)
        {
            loadError = "Something went wrong while loading this episode. Please try again.";
        }
        finally
        {
            isLoading = false;
        }

        if (episode is null)
        {
            return;
        }

        // Kept out of the try/catch above on purpose: playback state is supplementary (it only
        // seeds the resume position/badge), so a hiccup fetching it shouldn't hide an episode that
        // already loaded successfully.
        try
        {
            var state = await EpisodeStateClient.GetStateAsync(EpisodeId);
            episodeState = state;
            if (state is not null)
            {
                savedPositionSeconds = state.PositionSeconds;
                isCompleted = state.Completed;
                isAutoPlayed = state.AutoPlayed;
            }
        }
        catch (HttpRequestException)
        {
        }

        // Best-effort, mirroring iOS EpisodeDetailView.loadPlaybackSettings(): resolve the
        // effective speed from the per-show override, else the global setting, else 1.0. Kept out
        // of the episode try/catch for the same reason as playback state above — a settings hiccup
        // shouldn't hide an episode that loaded, it just leaves playback at 1.0x.
        try
        {
            var userSettingsTask = SettingsClient.GetSettingsAsync();
            var showSettingsTask = SettingsClient.GetShowSettingsAsync(ShowId);
            await Task.WhenAll(userSettingsTask, showSettingsTask);
            playbackSpeed = showSettingsTask.Result.PlaybackSpeed ?? userSettingsTask.Result.PlaybackSpeed;
        }
        catch (HttpRequestException)
        {
        }

        // Kicked off without awaiting so it never delays the episode's first paint — the API
        // normalizes and caches the transcript, which can take a moment on a cold cache. The
        // generation guard drops the result if the user navigated to another episode meanwhile.
        if (episode.TranscriptUrl is not null)
        {
            isTranscriptLoading = true;
            _ = LoadTranscriptAsync(ShowId, EpisodeId, _loadGeneration);
        }
    }

    private async Task LoadTranscriptAsync(string showId, string episodeId, int generation)
    {
        try
        {
            var result = await CatalogClient.GetEpisodeTranscriptAsync(showId, episodeId);
            if (generation == _loadGeneration)
            {
                transcript = result;
            }
        }
        // Broad on purpose: this runs detached from the Blazor lifecycle, so any escape (a
        // timeout's TaskCanceledException, a malformed-body JsonException, ...) would tear down the
        // circuit rather than surface as a component error. The transcript is best-effort content.
        catch (Exception)
        {
            if (generation == _loadGeneration)
            {
                transcriptLoadFailed = true;
            }
        }
        finally
        {
            if (generation == _loadGeneration)
            {
                isTranscriptLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (episode is null || _module is not null)
        {
            return;
        }

        // Dynamic import() specifiers must start with "/", "./", or "../" (or be a full URL) —
        // a bare "Components/..." path is parsed as a bare module specifier and fails to resolve.
        _module = await JS.InvokeAsync<IJSObjectReference>("import", $"./{Assets["Components/Pages/EpisodeDetail.razor.js"]}");
        _selfReference = DotNetObjectReference.Create(this);

        // Compare the synced state against this browser's own last-known playback (#243). If
        // another device moved the episode on, attach at *this* browser's position (so "Not now"
        // is a no-op) and offer the jump; otherwise attach at the synced position and record
        // that we're now in sync with it. Scoped to episodeState.UserId so a shared browser
        // profile keeps accounts' positions apart; skipped entirely when there's no state.
        if (episodeState is not null)
        {
            var local = await _module.InvokeAsync<LocalPlayback?>("readLocalPlayback", episodeState.UserId, EpisodeId);
            resumePrompt = CrossDeviceResume.Evaluate(episodeState, local?.Pos, ParseLocalUpdatedAt(local?.At));
        }

        var attachPosition = resumePrompt?.LocalPositionSeconds ?? savedPositionSeconds;
        _watcher = await _module.InvokeAsync<IJSObjectReference>("attach", _selfReference, audioElement, attachPosition, playbackSpeed);

        if (resumePrompt is null && episodeState is not null)
        {
            await WriteLocalPlaybackAsync(episodeState.UserId, savedPositionSeconds, episodeState.UpdatedAt);
        }

        // OnAfterRenderAsync doesn't trigger a re-render on its own — nudge one so the resume
        // banner (set just above) actually paints.
        if (resumePrompt is not null)
        {
            StateHasChanged();
        }
    }

    private sealed record LocalPlayback(int Pos, string At);

    private static DateTimeOffset? ParseLocalUpdatedAt(string? value) =>
        DateTimeOffset.TryParse(value, null, System.Globalization.DateTimeStyles.RoundtripKind, out var parsed)
            ? parsed
            : null;

    private async Task WriteLocalPlaybackAsync(string userId, int positionSeconds, DateTimeOffset syncedUpdatedAt)
    {
        if (_module is null)
        {
            return;
        }

        await SafeInvokeAsync(() => _module.InvokeVoidAsync(
            "writeLocalPlayback", userId, EpisodeId, positionSeconds, syncedUpdatedAt.ToString("o")).AsTask());
    }

    private async Task ResumeFromOtherDeviceAsync()
    {
        if (resumePrompt is null)
        {
            return;
        }

        var target = resumePrompt.OtherDevicePositionSeconds;
        resumePrompt = null;
        savedPositionSeconds = target;

        if (_watcher is not null)
        {
            await SafeInvokeAsync(() => _watcher.InvokeVoidAsync("setInitialPosition", target).AsTask());
        }

        // Claim the position for this browser (last-write-wins, per docs/sync-conventions.md) so
        // the devices converge and the prompt doesn't reappear on reload.
        await PersistStateAsync(target, completed: false);
    }

    private async Task DismissResumePromptAsync()
    {
        var prompt = resumePrompt;
        resumePrompt = null;
        if (prompt is null)
        {
            return;
        }

        // "Not now" keeps this browser's own position (the audio watcher is already attached
        // there). Persist it when there's genuine local progress so the two devices converge;
        // on an episode never played here just record the remote UpdatedAt locally so the same
        // write doesn't prompt again.
        savedPositionSeconds = prompt.LocalPositionSeconds;
        if (prompt.LocalPositionSeconds > 0)
        {
            await PersistStateAsync(prompt.LocalPositionSeconds, completed: false);
        }
        else if (episodeState is not null)
        {
            await WriteLocalPlaybackAsync(episodeState.UserId, prompt.LocalPositionSeconds, episodeState.UpdatedAt);
        }
    }

    [JSInvokable]
    public async Task OnPlaybackProgress(int positionSeconds)
    {
        await PersistStateAsync(positionSeconds, completed: false);
    }

    [JSInvokable]
    public async Task OnPlaybackEnded(int durationSeconds)
    {
        await PersistStateAsync(durationSeconds, completed: true);
    }

    // #244: the JS watcher reports play/pause so the handoff poll only runs while this browser is
    // actually playing.
    [JSInvokable]
    public Task OnPlaybackStateChanged(bool playing)
    {
        if (playing)
        {
            StartHandoffPoll();
        }
        else
        {
            StopHandoffPoll();
        }

        return Task.CompletedTask;
    }

    private void StartHandoffPoll()
    {
        if (_handoffPollCts is not null)
        {
            return;
        }

        var cts = new CancellationTokenSource();
        _handoffPollCts = cts;
        _ = HandoffPollLoopAsync(cts.Token);
    }

    private void StopHandoffPoll()
    {
        _handoffPollCts?.Cancel();
        _handoffPollCts?.Dispose();
        _handoffPollCts = null;
    }

    // Re-fetches the synced state every ~20s while playing and, if a different device has moved
    // it far enough from where this browser is, raises the non-disruptive handoff banner (#244).
    private async Task HandoffPollLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(20), cancellationToken);
                if (!cancellationToken.IsCancellationRequested)
                {
                    await CheckForHandoffAsync(cancellationToken);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    // One poll iteration — public so bunit can exercise it without waiting on the loop's timer.
    public async Task CheckForHandoffAsync(CancellationToken cancellationToken = default)
    {
        if (handoffDismissed || episode is null)
        {
            return;
        }

        EpisodeState? state;
        try
        {
            state = await EpisodeStateClient.GetStateAsync(EpisodeId, cancellationToken);
        }
        // Broad on purpose: this runs from a detached loop, so anything that escapes (a timeout's
        // TaskCanceledException, a malformed-body JsonException, a cancellation, ...) would tear
        // down the circuit. A failed poll just means no banner this round; the loop's own
        // while-condition handles stopping on cancellation.
        catch (Exception)
        {
            return;
        }

        if (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        // Compare against the live element time, not savedPositionSeconds (only refreshed on the
        // 15s progress tick / pause) — that lag matters right at the 15s threshold.
        var currentPosition = await GetLivePlaybackPositionAsync() ?? savedPositionSeconds;
        var banner = CrossDeviceHandoff.Evaluate(state, currentPosition, lastSurfacedHandoffUpdatedAt);

        // Records compare by value — only re-render when the banner actually changed (raised,
        // cleared, or retargeted), so a steady banner doesn't churn a render every poll.
        if (!Equals(banner, handoffBanner))
        {
            handoffBanner = banner;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<int?> GetLivePlaybackPositionAsync()
    {
        if (_watcher is null)
        {
            return null;
        }

        try
        {
            return await _watcher.InvokeAsync<int>("getCurrentPositionSeconds");
        }
        catch (Exception)
        {
            return null;
        }
    }

    private async Task JumpToHandoffAsync()
    {
        var banner = handoffBanner;
        if (banner is null)
        {
            return;
        }

        lastSurfacedHandoffUpdatedAt = banner.SourceUpdatedAt;
        handoffBanner = null;
        savedPositionSeconds = banner.TargetPositionSeconds;

        if (_watcher is not null)
        {
            await SafeInvokeAsync(() => _watcher.InvokeVoidAsync("seekTo", banner.TargetPositionSeconds).AsTask());
        }

        // Claim the position for this browser (LWW) so the two converge and the banner doesn't
        // immediately reappear for the same remote write.
        await PersistStateAsync(banner.TargetPositionSeconds, completed: false);
    }

    private void DismissHandoffBanner()
    {
        lastSurfacedHandoffUpdatedAt = handoffBanner?.SourceUpdatedAt;
        handoffBanner = null;
        handoffDismissed = true;
    }

    // Fired by EpisodeDetail.razor.js's isStreamBlocked() gate (#273) when "Stream over Wi-Fi
    // only" is on and the Network Information API reports a non-Wi-Fi connection — mirrors iOS's
    // AudioPlayer.streamBlockedMessage (#271).
    [JSInvokable]
    public Task OnStreamBlocked()
    {
        streamBlockedMessage = "Streaming is limited to Wi-Fi. Connect to Wi-Fi, or turn off "
            + "\"Stream over Wi-Fi only\" in Settings, to continue.";
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnStreamAllowed()
    {
        streamBlockedMessage = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ToggleCompletedAsync()
    {
        if (isTogglingCompleted)
        {
            return;
        }

        isTogglingCompleted = true;
        try
        {
            if (isAutoPlayed)
            {
                // Mirrors ShowDetail.razor's RestoreAsync: a restore always clears both Completed
                // and AutoPlayed and resets position, rather than reusing the generic "mark
                // unplayed" position-preserving path above.
                await PersistStateAsync(positionSeconds: 0, completed: false);
                return;
            }

            var newCompleted = !isCompleted;
            // Marking unplayed keeps the listener's saved position rather than discarding it — only
            // marking played jumps position to the end.
            var position = newCompleted ? (int)(episode?.Duration ?? TimeSpan.Zero).TotalSeconds : savedPositionSeconds;
            await PersistStateAsync(position, newCompleted);
        }
        finally
        {
            isTogglingCompleted = false;
        }
    }

    // Called both from the manual toggle button and from JS playback-progress callbacks, which can
    // legitimately overlap (e.g. 'pause' firing just before 'ended') — _persistGate serializes them
    // so a slower earlier call can't apply after and overwrite a later, more current one.
    private async Task PersistStateAsync(int positionSeconds, bool completed)
    {
        if (episode is null)
        {
            return;
        }

        await _persistGate.WaitAsync();
        try
        {
            stateError = null;
            var updated = await EpisodeStateClient.UpdateStateAsync(EpisodeId, ShowId, positionSeconds, completed);
            savedPositionSeconds = updated.PositionSeconds;
            isCompleted = updated.Completed;
            isAutoPlayed = updated.AutoPlayed;
            episodeState = updated;
            // Keep this browser's cross-device baseline (#243) current: it just wrote this
            // position and is in sync with the server UpdatedAt it got back.
            await WriteLocalPlaybackAsync(updated.UserId, updated.PositionSeconds, updated.UpdatedAt);
        }
        catch (HttpRequestException)
        {
            stateError = "Something went wrong while saving your playback progress.";
        }
        finally
        {
            _persistGate.Release();
            StateHasChanged();
        }
    }

    // No-ops (rather than erroring) if the JS interop watcher hasn't attached yet — OnAfterRenderAsync
    // only sets it up after the audio element exists, so a click racing that setup would otherwise
    // throw a NullReferenceException instead of silently doing nothing. Shared by the chapter list
    // and the transcript segment list.
    private async Task SeekToAsync(TimeSpan startTime)
    {
        if (_watcher is null)
        {
            return;
        }

        await SafeInvokeAsync(() => _watcher.InvokeVoidAsync("seekTo", startTime.TotalSeconds).AsTask());
    }

    // Applies the chosen speed to live playback immediately, then persists it back to the global
    // UserSettings.PlaybackSpeed — same behaviour as iOS EpisodeDetailView.cyclePlaybackSpeed().
    // A per-show override still takes precedence the next time the episode is opened; that
    // override is edited from the show screen, not here. The new rate stays applied even if the
    // save fails (the audio is already playing at it) — only a small "couldn't save" hint shows.
    private async Task OnPlaybackSpeedChangedAsync(ChangeEventArgs args)
    {
        if (!float.TryParse(
                args.Value?.ToString(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var value) ||
            !float.IsFinite(value) || value <= 0)
        {
            return;
        }

        playbackSpeed = value;
        playbackSpeedError = null;

        if (_watcher is not null)
        {
            await SafeInvokeAsync(() => _watcher.InvokeVoidAsync("setPlaybackRate", value).AsTask());
        }

        isPlaybackSpeedSaving = true;
        try
        {
            await SettingsClient.UpdatePlaybackSpeedAsync(value);
        }
        catch (HttpRequestException)
        {
            playbackSpeedError = "Couldn't save your speed.";
        }
        finally
        {
            isPlaybackSpeedSaving = false;
        }
    }

    // Splits a segment into alternating plain / matched runs so the view can wrap matches in
    // <mark> — case-insensitive, matching FilteredSegments' Contains check. An empty query yields
    // the whole string as a single non-highlighted run.
    private static IEnumerable<(string Text, bool Highlight)> HighlightMatches(string text, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            yield return (text, false);
            yield break;
        }

        var cursor = 0;
        while (cursor < text.Length)
        {
            var matchIndex = text.IndexOf(query, cursor, StringComparison.OrdinalIgnoreCase);
            if (matchIndex < 0)
            {
                yield return (text[cursor..], false);
                yield break;
            }

            if (matchIndex > cursor)
            {
                yield return (text[cursor..matchIndex], false);
            }

            yield return (text.Substring(matchIndex, query.Length), true);
            cursor = matchIndex + query.Length;
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Also invalidates any in-flight LoadTranscriptAsync so its completion doesn't call
        // StateHasChanged on a disposed component.
        _loadGeneration++;
        await DisposeInteropAsync();
    }

    private async Task DisposeInteropAsync()
    {
        StopHandoffPoll();

        if (_watcher is not null)
        {
            await SafeInvokeAsync(() => _watcher.InvokeVoidAsync("dispose").AsTask());
            await SafeInvokeAsync(() => _watcher.DisposeAsync().AsTask());
            _watcher = null;
        }

        if (_module is not null)
        {
            await SafeInvokeAsync(() => _module.DisposeAsync().AsTask());
            _module = null;
        }

        _selfReference?.Dispose();
        _selfReference = null;
    }

    // A circuit that's already gone (e.g. the tab was closed) throws JSDisconnectedException from
    // any further JS interop call — there's nothing left to clean up client-side in that case.
    private static async Task SafeInvokeAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
