@page "/shows/{ShowId}/episodes/{EpisodeId}"
@implements IAsyncDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Kuulla.Web.Models
@using Kuulla.Web.Services
@inject PodcastCatalogClient CatalogClient
@inject EpisodeStateClient EpisodeStateClient
@inject IJSRuntime JS

<PageTitle>@(episode?.Title ?? "Episode")</PageTitle>

@if (isLoading)
{
    <p>Loading&hellip;</p>
}
else if (loadError is not null)
{
    <p class="text-danger">@loadError</p>
}
else if (episode is null)
{
    <p>Episode not found.</p>
}
else
{
    <a href="@($"shows/{ShowId}")" class="d-inline-block mb-3">&larr; Back to show</a>

    <div class="d-flex align-items-center gap-2 mb-1">
        <h1 class="mb-0">@episode.Title</h1>
        <span class="badge @StatusBadgeClass">@StatusLabel</span>
    </div>

    <div class="text-muted mb-3">
        @if (episode.PublishedAt is { } publishedAt)
        {
            @publishedAt.ToLocalTime().ToString("MMM d, yyyy")
            <text> &middot; </text>
        }
        @if (episode.Duration is { } duration)
        {
            @EpisodeFormatting.FormatDuration(duration)
        }
    </div>

    <audio @ref="audioElement" controls preload="none" class="w-100 mb-2">
        <source src="@episode.AudioUrl" />
        Your browser does not support the audio element.
    </audio>

    @if (streamBlockedMessage is not null)
    {
        <p class="text-danger small mb-2">@streamBlockedMessage</p>
    }

    <div class="d-flex align-items-center gap-2 mb-4">
        <button class="btn btn-sm btn-outline-secondary" disabled="@isTogglingCompleted" @onclick="ToggleCompletedAsync">
            @(isAutoPlayed ? "Restore" : isCompleted ? "Mark as unplayed" : "Mark as played")
        </button>
        <AuthorizeView>
            <Authorized>
                <AddToPlaylistButton EpisodeId="@EpisodeId" ShowId="@ShowId" />
            </Authorized>
        </AuthorizeView>
    </div>

    @if (stateError is not null)
    {
        <p class="text-danger">@stateError</p>
    }

    @if (episode.Chapters is { Count: > 0 } chapters)
    {
        <h2>Chapters</h2>
        <ul class="list-group mb-4">
            @foreach (var chapter in chapters)
            {
                <li class="list-group-item d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(chapter.ImageUrl))
                    {
                        <img src="@chapter.ImageUrl" alt="" width="40" height="40" class="rounded flex-shrink-0" style="object-fit: cover;" />
                    }
                    <button type="button" class="btn btn-link text-start flex-grow-1 text-decoration-none p-0" @onclick="() => SeekToChapterAsync(chapter.StartTime)">
                        @chapter.Title
                    </button>
                    <span class="text-muted small flex-shrink-0">@EpisodeFormatting.FormatDuration(chapter.StartTime)</span>
                </li>
            }
        </ul>
    }

    @if (!string.IsNullOrEmpty(episode.Description))
    {
        <h2>Show notes</h2>
        <p style="white-space: pre-wrap;">@episode.Description</p>
    }
    else
    {
        <p class="text-muted">No show notes available for this episode.</p>
    }
}

@code {
    [Parameter]
    public string ShowId { get; set; } = "";

    [Parameter]
    public string EpisodeId { get; set; } = "";

    private Episode? episode;
    private bool isLoading;
    private string? loadError;

    private ElementReference audioElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _watcher;
    private DotNetObjectReference<EpisodeDetail>? _selfReference;

    private int savedPositionSeconds;
    private bool isCompleted;
    private bool isAutoPlayed;
    private bool isTogglingCompleted;
    private string? stateError;
    private string? streamBlockedMessage;

    // Serializes PersistStateAsync calls so overlapping triggers (pause firing just before ended,
    // or a timeupdate racing the manual toggle) apply in invocation order rather than completion
    // order — otherwise a slower earlier call's response could land after and overwrite a later
    // one's (e.g. a stale in-flight progress update clobbering a completed:true write).
    private readonly SemaphoreSlim _persistGate = new(1, 1);

    private string StatusLabel => isAutoPlayed ? "Auto-marked played"
        : isCompleted ? "Played"
        : savedPositionSeconds > 0 ? "In progress" : "New";

    private string StatusBadgeClass => isAutoPlayed ? "bg-success fst-italic"
        : isCompleted ? "bg-success"
        : savedPositionSeconds > 0 ? "bg-info text-dark" : "bg-secondary";

    protected override async Task OnParametersSetAsync()
    {
        await DisposeInteropAsync();

        episode = null;
        loadError = null;
        savedPositionSeconds = 0;
        isCompleted = false;
        isAutoPlayed = false;
        streamBlockedMessage = null;
        isLoading = true;
        try
        {
            episode = await CatalogClient.GetEpisodeAsync(ShowId, EpisodeId);
        }
        catch (HttpRequestException)
        {
            loadError = "Something went wrong while loading this episode. Please try again.";
        }
        finally
        {
            isLoading = false;
        }

        if (episode is null)
        {
            return;
        }

        // Kept out of the try/catch above on purpose: playback state is supplementary (it only
        // seeds the resume position/badge), so a hiccup fetching it shouldn't hide an episode that
        // already loaded successfully.
        try
        {
            var state = await EpisodeStateClient.GetStateAsync(EpisodeId);
            if (state is not null)
            {
                savedPositionSeconds = state.PositionSeconds;
                isCompleted = state.Completed;
                isAutoPlayed = state.AutoPlayed;
            }
        }
        catch (HttpRequestException)
        {
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (episode is null || _module is not null)
        {
            return;
        }

        // Dynamic import() specifiers must start with "/", "./", or "../" (or be a full URL) —
        // a bare "Components/..." path is parsed as a bare module specifier and fails to resolve.
        _module = await JS.InvokeAsync<IJSObjectReference>("import", $"./{Assets["Components/Pages/EpisodeDetail.razor.js"]}");
        _selfReference = DotNetObjectReference.Create(this);
        _watcher = await _module.InvokeAsync<IJSObjectReference>("attach", _selfReference, audioElement, savedPositionSeconds);
    }

    [JSInvokable]
    public async Task OnPlaybackProgress(int positionSeconds)
    {
        await PersistStateAsync(positionSeconds, completed: false);
    }

    [JSInvokable]
    public async Task OnPlaybackEnded(int durationSeconds)
    {
        await PersistStateAsync(durationSeconds, completed: true);
    }

    // Fired by EpisodeDetail.razor.js's isStreamBlocked() gate (#273) when "Stream over Wi-Fi
    // only" is on and the Network Information API reports a non-Wi-Fi connection — mirrors iOS's
    // AudioPlayer.streamBlockedMessage (#271).
    [JSInvokable]
    public Task OnStreamBlocked()
    {
        streamBlockedMessage = "Streaming is limited to Wi-Fi. Connect to Wi-Fi, or turn off "
            + "\"Stream over Wi-Fi only\" in Settings, to continue.";
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnStreamAllowed()
    {
        streamBlockedMessage = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ToggleCompletedAsync()
    {
        if (isTogglingCompleted)
        {
            return;
        }

        isTogglingCompleted = true;
        try
        {
            if (isAutoPlayed)
            {
                // Mirrors ShowDetail.razor's RestoreAsync: a restore always clears both Completed
                // and AutoPlayed and resets position, rather than reusing the generic "mark
                // unplayed" position-preserving path above.
                await PersistStateAsync(positionSeconds: 0, completed: false);
                return;
            }

            var newCompleted = !isCompleted;
            // Marking unplayed keeps the listener's saved position rather than discarding it — only
            // marking played jumps position to the end.
            var position = newCompleted ? (int)(episode?.Duration ?? TimeSpan.Zero).TotalSeconds : savedPositionSeconds;
            await PersistStateAsync(position, newCompleted);
        }
        finally
        {
            isTogglingCompleted = false;
        }
    }

    // Called both from the manual toggle button and from JS playback-progress callbacks, which can
    // legitimately overlap (e.g. 'pause' firing just before 'ended') — _persistGate serializes them
    // so a slower earlier call can't apply after and overwrite a later, more current one.
    private async Task PersistStateAsync(int positionSeconds, bool completed)
    {
        if (episode is null)
        {
            return;
        }

        await _persistGate.WaitAsync();
        try
        {
            stateError = null;
            var updated = await EpisodeStateClient.UpdateStateAsync(EpisodeId, ShowId, positionSeconds, completed);
            savedPositionSeconds = updated.PositionSeconds;
            isCompleted = updated.Completed;
            isAutoPlayed = updated.AutoPlayed;
        }
        catch (HttpRequestException)
        {
            stateError = "Something went wrong while saving your playback progress.";
        }
        finally
        {
            _persistGate.Release();
            StateHasChanged();
        }
    }

    // No-ops (rather than erroring) if the JS interop watcher hasn't attached yet — OnAfterRenderAsync
    // only sets it up after the audio element exists, so a click racing that setup would otherwise
    // throw a NullReferenceException instead of silently doing nothing.
    private async Task SeekToChapterAsync(TimeSpan startTime)
    {
        if (_watcher is null)
        {
            return;
        }

        await SafeInvokeAsync(() => _watcher.InvokeVoidAsync("seekTo", startTime.TotalSeconds).AsTask());
    }

    public async ValueTask DisposeAsync() => await DisposeInteropAsync();

    private async Task DisposeInteropAsync()
    {
        if (_watcher is not null)
        {
            await SafeInvokeAsync(() => _watcher.InvokeVoidAsync("dispose").AsTask());
            await SafeInvokeAsync(() => _watcher.DisposeAsync().AsTask());
            _watcher = null;
        }

        if (_module is not null)
        {
            await SafeInvokeAsync(() => _module.DisposeAsync().AsTask());
            _module = null;
        }

        _selfReference?.Dispose();
        _selfReference = null;
    }

    // A circuit that's already gone (e.g. the tab was closed) throws JSDisconnectedException from
    // any further JS interop call — there's nothing left to clean up client-side in that case.
    private static async Task SafeInvokeAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
