@using Kuulla.Web.Models

<a href="@($"shows/{Show.Id}")" class="text-decoration-none text-body">
    @if (!string.IsNullOrEmpty(Show.ArtworkUrl))
    {
        <img src="@Show.ArtworkUrl" alt="@Show.Title" class="img-fluid rounded show-card-img" />
    }
    <h5 class="mt-2 mb-0">@Show.Title</h5>
    <p class="text-muted small">@Show.Author</p>
</a>

@code {
    [Parameter, EditorRequired]
    public required Show Show { get; set; }
}
