@inject IHostEnvironment HostEnvironment

<div class="top-row navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
                <rect x="2" y="9" width="4" height="14" rx="2" />
                <rect x="9" y="5" width="4" height="22" rx="2" />
                <rect x="16" y="11" width="4" height="10" rx="2" />
            </svg>
            Kuulla
        </a>

        <button type="button" class="theme-toggle" title="Toggle theme" aria-label="Toggle color theme" aria-pressed="true" onclick="window.kuullaTheme?.toggle()">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.4 5.4 0 0 1-7.54-7.54c-.44-.06-.9-.1-1.36-.1z"/></svg>
        </button>

        <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

        <nav class="nav-links" onclick="document.querySelector('.navbar-toggler').click()">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Library</NavLink>
            <NavLink class="nav-link" href="search">Search</NavLink>

            <AuthorizeView>
                <Authorized>
                    <NavLink class="nav-link" href="new-episodes">New Episodes</NavLink>
                    <NavLink class="nav-link" href="subscriptions">Subscriptions</NavLink>
                    <NavLink class="nav-link" href="up-next">Up Next</NavLink>
                    <NavLink class="nav-link" href="playlists">Playlists</NavLink>
                    <NavLink class="nav-link" href="settings">Settings</NavLink>
                    @if (HostEnvironment.IsDevelopment())
                    {
                        <NavLink class="nav-link" href="jwt">JWT</NavLink>
                    }
                </Authorized>
            </AuthorizeView>

            <div class="nav-auth">
                <LoginDisplay />
            </div>
        </nav>
    </div>
</div>
